<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 默认值 = 浅色 + Default 强调色。运行时由 ThemeService 按设置覆盖同名资源。 -->

    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Item">10</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">1000</CornerRadius>

    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>

    <!-- 以 Color 形式提供：阴影着色 -->
    <Color x:Key="Shadow.Tint">#2A3040</Color>

    <!-- 窗口底纹与卡片封面渐变 -->
    <LinearGradientBrush x:Key="Brush.WindowBackground" StartPoint="0.88,0" EndPoint="0.12,1">
        <GradientStop Color="#E9EDF9" Offset="0" />
        <GradientStop Color="#F8FAFD" Offset="0.42" />
        <GradientStop Color="#E9EDF9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.CardCover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A3A6B" Offset="0" />
        <GradientStop Color="#4F6FD8" Offset="1" />
    </LinearGradientBrush>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="Accent.Deep" Color="#2A3A6B" />
    <SolidColorBrush x:Key="Accent.Base" Color="#3B55A0" />
    <SolidColorBrush x:Key="Accent.Bright" Color="#4F6FD8" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#4563C4" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#D5DCF2" />
    <SolidColorBrush x:Key="Accent.Faint" Color="#EFF2FB" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text.Primary" Color="#2B3242" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5F6B80" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8B94A6" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#C2C8D4" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />

    <!-- 承载面 -->
    <SolidColorBrush x:Key="Surface.Window" Color="#F6F7FA" />
    <SolidColorBrush x:Key="Surface.Panel" Color="#EFF1F6" />
    <SolidColorBrush x:Key="Surface.PanelGlass" Color="#C7EFF1F6" />
    <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.CardGlass" Color="#D1FFFFFF" />
    <SolidColorBrush x:Key="Surface.CardHover" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="#F1F3F8" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="#59000000" />

    <!--
        游戏内 HUD 的文字色：固定浅色。HUD 的底色直接写在窗口 XAML 里（永远是深色，不跟主题走），
        这里只提供配套的文字色，代码里也按这几个键取。
    -->
    <SolidColorBrush x:Key="Text.OnHud" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.OnHudDim" Color="#D8DEE8" />
    <SolidColorBrush x:Key="Text.OnHudFaint" Color="#AEB6C4" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="Border.Default" Color="#E2E6EF" />
    <SolidColorBrush x:Key="Border.Strong" Color="#CBD2E0" />

    <!-- 状态 -->
    <SolidColorBrush x:Key="Status.Warn" Color="#C07A12" />
    <SolidColorBrush x:Key="Status.WarnSoft" Color="#FCF3E3" />
    <SolidColorBrush x:Key="Status.Danger" Color="#C0392B" />
    <SolidColorBrush x:Key="Status.DangerSoft" Color="#FBE9E7" />
    <SolidColorBrush x:Key="Status.Success" Color="#3E8E4E" />

    <!-- 侧栏导航 -->
    <SolidColorBrush x:Key="Nav.ItemHover" Color="#E8EBF3" />
    <SolidColorBrush x:Key="Nav.ItemActive" Color="#DCE3F5" />
    <SolidColorBrush x:Key="Nav.Indicator" Color="#4F6FD8" />
    <SolidColorBrush x:Key="Nav.Text" Color="#5C6880" />
    <SolidColorBrush x:Key="Nav.TextActive" Color="#3B55A0" />

    <!-- 通用透明与遮罩 -->
    <SolidColorBrush x:Key="Common.Transparent" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Common.HalfWhite" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Common.SemiBlack" Color="#40000000" />

</ResourceDictionary>
