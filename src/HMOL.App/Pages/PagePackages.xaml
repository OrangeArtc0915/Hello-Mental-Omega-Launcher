<c:LauncherPage xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Pages.PagePackages"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:HMOL.App.Controls"
                xmlns:svg="clr-namespace:HMOL.App.Controls.Svg">

    <c:LauncherPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </c:LauncherPage.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：与其余页面同一形态，本页操作按钮组放在右侧 -->
        <c:PageHeader x:Name="HeaderPackages"
                      Grid.Row="0"
                      Title="{loc:T '包管理'}"
                      Subtitle="{loc:T '导入、安装、卸载与移除游戏包（INI / 地图 / 任务 / 插件）'}"
                      Icon="lucide/package">
            <StackPanel Orientation="Horizontal">
                <c:OutlineButton Content="{loc:T '导入包'}"
                                 ToolTip="{loc:T '把选中的压缩包复制进当前分类的包目录'}"
                                 Tone="Solid"
                                 Click="OnImportPackageClick" />
                <c:OutlineButton Margin="8,0,0,0"
                                 Content="{loc:T '打开包目录'}"
                                 Click="OnOpenPackageDirClick" />
                <c:OutlineButton Margin="8,0,0,0"
                                 Content="{loc:T '刷新'}"
                                 Click="OnRefreshClick" />
            </StackPanel>
        </c:PageHeader>

        <!-- 提示条与当前实例 -->
        <StackPanel x:Name="PanInstanceStrip" Grid.Row="1" Margin="0,12,0,0">
            <Border x:Name="BarNotice"
                    Margin="0,0,0,10"
                    Padding="12,10"
                    Background="{DynamicResource Accent.Faint}"
                    CornerRadius="{DynamicResource Radius.Item}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <svg:SvgIcon x:Name="IconNotice"
                                 Grid.Column="0"
                                 Width="16"
                                 Height="16"
                                 Margin="0,1,0,0"
                                 VerticalAlignment="Top"
                                 Icon="lucide/info"
                                 IconBrush="{DynamicResource Accent.Base}" />

                    <TextBlock x:Name="LabNotice"
                               Grid.Column="1"
                               Margin="10,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />

                    <c:RoundIconButton Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Icon="lucide/x"
                                       IconSize="13"
                                       Tone="Plain"
                                       Click="OnDismissNoticeClick" />
                </Grid>
            </Border>

            <Border Padding="12,10"
                    Background="{DynamicResource Surface.Sunken}"
                    CornerRadius="{DynamicResource Radius.Item}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Surface.Card}"
                            CornerRadius="{DynamicResource Radius.Small}">
                        <svg:SvgIcon Width="13"
                                     Height="13"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Icon="lucide/layers"
                                     IconBrush="{DynamicResource Accent.Base}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock x:Name="LabInstance"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabInstancePath"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>

                    <c:OutlineButton Grid.Column="2"
                                     Padding="12,5"
                                     VerticalAlignment="Center"
                                     Content="{loc:T '管理实例'}"
                                     FontSize="12"
                                     Click="OnManageInstanceClick" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- 类型分段控件：视图切换单独成行，不与页头操作混在一起 -->
        <StackPanel x:Name="PanTypeTabs" Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel>
                <c:OutlineButton x:Name="BtnTabIni"
                                 Padding="16,6"
                                 FontSize="12.5"
                                 Tag="0"
                                 Tone="Solid"
                                 Click="OnTabClick" />
                <c:OutlineButton x:Name="BtnTabMap"
                                 Margin="8,0,0,0"
                                 Padding="16,6"
                                 FontSize="12.5"
                                 Tag="1"
                                 Click="OnTabClick" />
                <c:OutlineButton x:Name="BtnTabMission"
                                 Margin="8,0,0,0"
                                 Padding="16,6"
                                 FontSize="12.5"
                                 Tag="2"
                                 Click="OnTabClick" />
                <c:OutlineButton x:Name="BtnTabPlugin"
                                 Margin="8,0,0,0"
                                 Padding="16,6"
                                 FontSize="12.5"
                                 Tag="3"
                                 Click="OnTabClick" />
            </WrapPanel>

            <TextBlock x:Name="LabTypeHint"
                       Margin="0,8,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 可用包 / 已安装 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <c:SurfaceCard x:Name="CardAvailable"
                           Grid.Column="0"
                           HasHoverEffect="False"
                           Title="{loc:T '可用包'}"
                           UseShadow="False">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PanAvailable">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,8"
                                            Background="{DynamicResource Surface.Sunken}"
                                            CornerRadius="{DynamicResource Radius.Item}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding Detail}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Status.Success}"
                                                       Text="{loc:T '已安装'}"
                                                       Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <c:OutlineButton Padding="12,4"
                                                                 Content="{loc:T '安装'}"
                                                                 FontSize="12"
                                                                 Tag="{Binding}"
                                                                 Tone="Solid"
                                                                 Click="OnInstallClick" />
                                                <c:OutlineButton Margin="6,0,0,0"
                                                                 Padding="12,4"
                                                                 Content="{loc:T '移除'}"
                                                                 FontSize="12"
                                                                 Tag="{Binding}"
                                                                 Tone="Plain"
                                                                 Click="OnRemovePackageClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态：图标底色块 + 12.5px 说明（与主页空态同构） -->
                    <StackPanel x:Name="PanAvailableEmpty"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{DynamicResource Radius.Card}">
                            <svg:SvgIcon Width="26"
                                         Height="26"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="lucide/package"
                                         IconBrush="{DynamicResource Accent.Base}" />
                        </Border>

                        <TextBlock x:Name="LabAvailableEmpty"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:T '这个分类下还没有可用的包'}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="{loc:T '把包文件放进包目录，或点右上角「导入包」。'}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </c:SurfaceCard>

            <c:SurfaceCard x:Name="CardInstalled"
                           Grid.Column="2"
                           HasHoverEffect="False"
                           Title="{loc:T '当前实例已安装'}"
                           UseShadow="False">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PanInstalled">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,8"
                                            Background="{DynamicResource Surface.Sunken}"
                                            CornerRadius="{DynamicResource Radius.Item}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding Detail}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <c:OutlineButton Grid.Column="1"
                                                             Padding="12,4"
                                                             VerticalAlignment="Center"
                                                             Content="{loc:T '卸载'}"
                                                             FontSize="12"
                                                             Tag="{Binding}"
                                                             Tone="Danger"
                                                             Click="OnUninstallClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态：图标底色块 + 12.5px 说明（与主页空态同构） -->
                    <StackPanel x:Name="PanInstalledEmpty"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{DynamicResource Radius.Card}">
                            <svg:SvgIcon Width="26"
                                         Height="26"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="lucide/circle-check"
                                         IconBrush="{DynamicResource Accent.Base}" />
                        </Border>

                        <TextBlock x:Name="LabInstalledEmpty"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:T '当前实例还没有安装这个分类的包'}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="{loc:T '在左边选一个包点「安装」即可。'}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </c:SurfaceCard>
        </Grid>
    </Grid>
</c:LauncherPage>
