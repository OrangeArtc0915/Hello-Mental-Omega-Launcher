<c:LauncherPage xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Pages.PageLog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:HMOL.App.Controls"
                xmlns:svg="clr-namespace:HMOL.App.Controls.Svg">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：与其余页面同一形态（图标块 + 18 粗标题 + 12 次要色副标题） -->
        <c:PageHeader x:Name="HeaderLog"
                      Grid.Row="0"
                      Title="{loc:T '运行日志'}"
                      Subtitle="{loc:T '启动器的操作记录与游戏进程输出；内存里只留最近 500 条，切走页面也不会丢'}"
                      Icon="lucide/scroll-text" />

        <!-- 数据来源：内存日志按来源分两块，磁盘日志看落盘文件。视图切换单独一行，不与页头操作混在一起 -->
        <StackPanel x:Name="PanLogTabs"
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnAppLog"
                             Content="{loc:T '应用日志'}"
                             Tag="0"
                             Tone="Solid"
                             Click="OnTabClick" />
            <c:OutlineButton x:Name="BtnGameLog"
                             Margin="8,0,0,0"
                             Content="{loc:T '游戏日志'}"
                             Tag="1"
                             Click="OnTabClick" />
            <c:OutlineButton x:Name="BtnDiskLog"
                             Margin="8,0,0,0"
                             Content="{loc:T '磁盘日志'}"
                             Tag="2"
                             Click="OnTabClick" />
        </StackPanel>

        <!-- 操作栏 -->
        <StackPanel x:Name="PanLogOps"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
            <c:OutlineButton Content="{loc:T '刷新'}" Click="OnRefreshClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="{loc:T '清空视图'}"
                             Click="OnClearClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="{loc:T '导出 TXT'}"
                             Click="OnExportTxtClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="{loc:T '导出 CSV'}"
                             Click="OnExportCsvClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="{loc:T '打开日志目录'}"
                             Click="OnOpenLogFolderClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="{loc:T '清理旧日志'}"
                             Tone="Danger"
                             Click="OnCleanupClick" />
            <TextBlock x:Name="LabStatus"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}" />
        </StackPanel>

        <!-- 磁盘日志的文件选择：每个文件一个按钮，选中的为实心 -->
        <ScrollViewer x:Name="ScrollFiles"
                      Grid.Row="3"
                      Margin="0,10,0,0"
                      MaxHeight="76"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <WrapPanel x:Name="PanFiles" />
        </ScrollViewer>

        <c:SurfaceCard x:Name="CardLog"
                       Grid.Row="4"
                       Margin="0,12,0,0"
                       UseShadow="False"
                       HasHoverEffect="False">
            <Grid>
                <!-- 空状态：图标底色块 + 12.5px 说明 + 引导按钮（与主页空态同构） -->
                <StackPanel x:Name="PanLogEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="54"
                            Height="54"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Accent.Faint}"
                            CornerRadius="{DynamicResource Radius.Card}">
                        <svg:SvgIcon Width="26"
                                     Height="26"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Icon="lucide/scroll-text"
                                     IconBrush="{DynamicResource Accent.Base}" />
                    </Border>

                    <TextBlock x:Name="LabEmpty"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:T '还没有日志。'}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <c:OutlineButton Margin="0,14,0,0"
                                     HorizontalAlignment="Center"
                                     Content="{loc:T '刷新'}"
                                     Tone="Solid"
                                     Click="OnRefreshClick" />
                </StackPanel>

                <ScrollViewer x:Name="ScrollLog"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel x:Name="PanLines" />
                </ScrollViewer>
            </Grid>
        </c:SurfaceCard>
    </Grid>
</c:LauncherPage>
