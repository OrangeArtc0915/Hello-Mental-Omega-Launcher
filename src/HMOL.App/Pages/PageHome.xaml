<c:LauncherPage x:Class="HMOL.App.Pages.PageHome"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:HMOL.App.Controls"
                xmlns:core="clr-namespace:HMOL.Core.App;assembly=HMOL.Core"
                xmlns:svg="clr-namespace:HMOL.App.Controls.Svg">

    <c:LauncherPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 小组件卡片头部的标题文字 -->
        <Style x:Key="WidgetTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>

        <!-- 月历里的日期数字 -->
        <Style x:Key="CalendarDay" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </c:LauncherPage.Resources>

    <!--
        主页分区（按外层栅格的 Grid.Row 自上而下，视觉分量递减）：
        ① 欢迎横幅（Grid.Row=0）—— 图标方块 + 按时段问候 + 版本徽标 + 当前状态摘要，右侧一块纯矢量装饰；
        ② 舞台（Grid.Row=1，弹性高度）—— 游戏启动入口：可自由定位的四张卡（布局编辑器管这一块）；
        ③ 小组件（Grid.Row=2）—— 日历 / 天气 / 常用网站三块并排（现实生活信息，与游戏状态无关）。
        横幅与小组件都放在舞台之外的栅格行里，不参与「主页自由定位」。
        显示顺序只看 Grid.Row，与元素在本文件里的书写顺序无关。
    -->
    <!--
        页面级滚动：ScrollViewer 只负责在装不下时出现滚动条。
        纵向留白放在 ScrollViewer 上、不放进滚动内容里，内层栅格才能用「至少与可视区等高」表达
        「窗口够大时铺满（弹性行 PanHomeStage 仍拉伸，百分比基准不塌），装不下时才滚动」。
    -->
    <ScrollViewer x:Name="ScrollHome"
                  Margin="0,16,0,12"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,0"
              MinHeight="{Binding ViewportHeight, ElementName=ScrollHome}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ① 欢迎横幅 -->
            <c:SurfaceCard x:Name="CardBanner"
                           Grid.Row="0"
                           Padding="0"
                           HasHoverEffect="False">
                <Grid Height="84">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 程序自己的图标：与标题栏、任务栏保持一致 -->
                    <Border Grid.Column="0"
                            Width="58"
                            Height="58"
                            Margin="18,0,16,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Accent.Faint}"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Radius.Card}">
                        <Image Width="58"
                               Height="58"
                               Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel x:Name="PanBannerText"
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LabGreeting"
                                       VerticalAlignment="Center"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}" />
                            <Border Margin="10,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{StaticResource Radius.Pill}">
                                <TextBlock FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}"
                                           Text="{x:Static core:AppInfo.VersionDisplay}" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="LabBannerStatus"
                                   Margin="0,8,0,0"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--
                        纯矢量装饰：渐变底（主题里的卡片封面渐变）+ 大号半透明 SVG 水印 + 细描边。
                        没有图片素材，换主题 / 换强调色时会跟着变。
                    -->
                    <Border x:Name="BorBannerArt"
                            Grid.Column="2"
                            Width="212"
                            Height="72"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Radius.Item}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border Background="{DynamicResource Brush.CardCover}" Opacity="0.16" />

                            <svg:SvgIcon Width="112"
                                         Height="112"
                                         Margin="0,0,-4,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Icon="lucide/flag"
                                         IconBrush="{DynamicResource Accent.Base}"
                                         IsHitTestVisible="False"
                                         Opacity="0.15"
                                         RenderTransformOrigin="0.5,0.5">
                                <svg:SvgIcon.RenderTransform>
                                    <RotateTransform Angle="-14" />
                                </svg:SvgIcon.RenderTransform>
                            </svg:SvgIcon>

                            <svg:SvgIcon Width="30"
                                         Height="30"
                                         Margin="20,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Icon="lucide/anvil"
                                         IconBrush="{DynamicResource Accent.Base}"
                                         IsHitTestVisible="False"
                                         Opacity="0.55" />

                            <Border BorderBrush="{DynamicResource Accent.Soft}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Item}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
            </c:SurfaceCard>

            <!--
                ③ 小组件：日历 / 天气 / 常用网站，一行三块等宽并排；第二行放扩展小组件（每个已启用的扩展一张卡）。
                用等宽列而不是固定像素宽的瀑布流：主窗口有最小宽度，等宽列在任何宽度下都只会等比收缩，
                三块永远排在一行且不会被裁切。扩展卡用等分栅格（每行 3 张）跟着同一套宽度走，
                窄窗口下与上面三块一起等比收缩、自动换到下一行。
            -->
            <Grid x:Name="GrdWidgets" Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColWidgetCalendar" Width="1.1*" />
                    <ColumnDefinition x:Name="ColWidgetGap1" Width="12" />
                    <ColumnDefinition x:Name="ColWidgetWeather" Width="1.05*" />
                    <ColumnDefinition x:Name="ColWidgetGap2" Width="12" />
                    <ColumnDefinition x:Name="ColWidgetSites" Width="0.95*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 扩展小组件：一张都没有时这一行高度为 0，整块看起来与以前完全一样 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ③-1 日历：现实月份，今天用强调色实心块高亮 -->
                <c:SurfaceCard x:Name="CardCalendar"
                               Grid.Column="0"
                               MinHeight="184"
                               HasHoverEffect="False"
                               Padding="0">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="14"
                                         Height="14"
                                         VerticalAlignment="Center"
                                         Icon="lucide/grid-2x2"
                                         IconBrush="{DynamicResource Accent.Base}" />

                            <!-- 标题兼「回到本月」：翻到别的月份后点一下就能回来 -->
                            <TextBlock x:Name="LabCalendarTitle"
                                       Grid.Column="1"
                                       Style="{StaticResource WidgetTitle}"
                                       Cursor="Hand"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       MouseLeftButtonUp="OnCalendarTitleClick"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="回到本月" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <c:RoundIconButton Width="24"
                                                   Height="24"
                                                   Icon="lucide/chevron-left"
                                                   IconSize="13"
                                                   Tone="Plain"
                                                   ToolTip="上一个月"
                                                   Click="OnCalendarPrevClick" />
                                <c:RoundIconButton Width="24"
                                                   Height="24"
                                                   Margin="2,0,0,0"
                                                   Icon="lucide/chevron-right"
                                                   IconSize="13"
                                                   Tone="Plain"
                                                   ToolTip="下一个月"
                                                   Click="OnCalendarNextClick" />
                            </StackPanel>
                        </Grid>

                        <!-- 星期表头与日期格都是 7 列，由代码填内容 -->
                        <UniformGrid x:Name="CalWeekdays"
                                     Grid.Row="1"
                                     Margin="0,8,0,2"
                                     Columns="7" />
                        <UniformGrid x:Name="CalDays" Grid.Row="2" Columns="7" />
                    </Grid>
                </c:SurfaceCard>

                <!-- ③-2 天气：Open-Meteo 实时数据，30 分钟内走缓存 -->
                <c:SurfaceCard x:Name="CardWeather"
                               Grid.Column="2"
                               MinHeight="184"
                               HasHoverEffect="False"
                               Padding="0">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="14"
                                         Height="14"
                                         VerticalAlignment="Center"
                                         Icon="lucide/earth"
                                         IconBrush="{DynamicResource Accent.Base}" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource WidgetTitle}"
                                       Text="天气" />
                            <TextBlock x:Name="LabWeatherCity"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />

                            <c:RoundIconButton x:Name="BtnRefreshWeather"
                                               Grid.Column="3"
                                               Width="24"
                                               Height="24"
                                               Margin="4,0,0,0"
                                               Icon="lucide/refresh-cw"
                                               IconSize="12"
                                               Tone="Plain"
                                               ToolTip="刷新天气"
                                               Click="OnRefreshWeatherClick" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <!-- 还没设置城市 -->
                            <StackPanel x:Name="PanWeatherNoCity"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock FontSize="12.5"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="还没设置城市"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="在「设置」里填一个城市，就能看到实时天气。"
                                           TextWrapping="Wrap" />
                                <c:OutlineButton Margin="0,10,0,0"
                                                 Padding="12,5"
                                                 HorizontalAlignment="Left"
                                                 FontSize="12"
                                                 Content="去设置"
                                                 Click="OnGoSettingsClick" />
                            </StackPanel>

                            <!-- 天气主体 -->
                            <StackPanel x:Name="PanWeather">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 天气图形由 WeatherGlyph 按 WMO 天气码给，纯几何、不占素材 -->
                                    <Path x:Name="IcoWeather"
                                          Grid.Column="0"
                                          Width="34"
                                          Height="34"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Accent.Base}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.6"
                                          Stretch="Uniform" />

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="LabWeatherTemp"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent.Base}" />
                                        <TextBlock x:Name="LabWeatherDesc"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="LabWeatherDetail"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- 失败或退回缓存时的可读提示 -->
                        <TextBlock x:Name="LabWeatherNote"
                                   Grid.Row="2"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Status.Warn}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>
                </c:SurfaceCard>

                <!-- ③-3 常用网站：点击用系统默认浏览器打开 -->
                <c:SurfaceCard x:Name="CardSites"
                               Grid.Column="4"
                               MinHeight="184"
                               HasHoverEffect="False"
                               Padding="0">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="14"
                                         Height="14"
                                         VerticalAlignment="Center"
                                         Icon="lucide/link-2"
                                         IconBrush="{DynamicResource Accent.Base}" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource WidgetTitle}"
                                       Text="常用网站" />
                            <TextBlock x:Name="LabSitesCount"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}" />
                        </Grid>

                        <ScrollViewer x:Name="ScrollSites"
                                      Grid.Row="1"
                                      Margin="0,8,0,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PanSites" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 悬停只改底色（样式触发），不给行加动画，省得离开页面还要逐个收尾 -->
                                        <Border Margin="0,0,0,5"
                                                Padding="8,6"
                                                CornerRadius="{StaticResource Radius.Item}"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="OnSiteClick"
                                                Tag="{Binding Url}"
                                                ToolTip="{Binding Url}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Surface.CardHover}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <svg:SvgIcon Grid.Column="0"
                                                             Width="13"
                                                             Height="13"
                                                             VerticalAlignment="Center"
                                                             Icon="lucide/globe"
                                                             IconBrush="{DynamicResource Text.Tertiary}" />

                                                <StackPanel Grid.Column="1"
                                                            Margin="8,0,6,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding Host}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <svg:SvgIcon Grid.Column="2"
                                                             Width="13"
                                                             Height="13"
                                                             VerticalAlignment="Center"
                                                             Icon="lucide/external-link"
                                                             IconBrush="{DynamicResource Accent.Base}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 列表为空时的引导 -->
                        <StackPanel x:Name="PanSitesEmpty"
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock FontSize="12.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="还没有常用网站"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       Text="在「设置 → 常用网站」里添加，或一键恢复默认清单。"
                                       TextWrapping="Wrap" />
                            <c:OutlineButton Margin="0,10,0,0"
                                             Padding="12,5"
                                             HorizontalAlignment="Left"
                                             FontSize="12"
                                             Content="去设置"
                                             Click="OnGoSettingsClick" />
                        </StackPanel>
                    </Grid>
                </c:SurfaceCard>

                <!--
                    ③-4 扩展小组件：每个已启用的扩展一张卡，与上面三块同款（标题行带图标、主数值、文字行）。
                    这些卡的内容全部来自扩展清单里的声明（纯文字 / 图标名 / 网址），宿主只负责渲染。
                    · 布局用等分栅格，每行 3 张，跟着上面三块的宽度走；
                    · 负外边距把卡片自己的 12 间距抵掉，让扩展卡与上面三块左右对齐；
                    · 一张都没有时整块 Collapsed，不占位。
                -->
                <ItemsControl x:Name="PanExtensionWidgets"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="5"
                              Margin="0,12,-12,-12"
                              Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard MinHeight="184"
                                           Margin="0,0,12,12"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           Loaded="OnExtensionCardLoaded"
                                           MouseLeftButtonUp="OnExtensionCardClick">
                                <Grid Margin="14,12,14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 标题行：图标 + 扩展名 + 来源（作者 / 版本） -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <svg:SvgIcon Grid.Column="0"
                                                     Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center"
                                                     Icon="{Binding Icon}"
                                                     IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource WidgetTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="{Binding Id}"
                                                   AutomationProperties.Name="{Binding A11yName}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding SourceLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- 正常内容：主数值 + 文字行 + 数据源降级时的弱化提示 -->
                                    <StackPanel Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="25"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent.Base}"
                                                   Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,2"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 数据源取不到时的弱化提示：内容退回清单里的静态值 -->
                                        <StackPanel Margin="0,6,0,0"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                            <svg:SvgIcon Width="12"
                                                         Height="12"
                                                         Margin="0,1,0,0"
                                                         VerticalAlignment="Top"
                                                         Icon="lucide/info"
                                                         IconBrush="{DynamicResource Text.Disabled}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource Text.Disabled}"
                                                       Text="{Binding Note}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 出错占位：只落在这一张卡上，不弹窗、不影响其它小组件 -->
                                    <StackPanel Grid.Row="1"
                                                Margin="0,8,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                        <svg:SvgIcon Width="18"
                                                     Height="18"
                                                     HorizontalAlignment="Left"
                                                     Icon="lucide/triangle-alert"
                                                     IconBrush="{DynamicResource Status.Warn}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Status.Warn}"
                                                   Text="{Binding ErrorText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 配了「点击打开网址」时整张卡可点（鼠标手型），这里是提示条 -->
                                    <Border Grid.Row="2"
                                            Margin="0,8,0,0"
                                            Padding="8,5"
                                            Background="{DynamicResource Surface.Sunken}"
                                            CornerRadius="{StaticResource Radius.Item}"
                                            ToolTip="{Binding Link}"
                                            Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Accent.Base}"
                                                       Text="{Binding LinkLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <svg:SvgIcon Grid.Column="1"
                                                         Width="12"
                                                         Height="12"
                                                         Margin="6,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/external-link"
                                                         IconBrush="{DynamicResource Accent.Base}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!--
                ② 主页舞台：流式布局与自由定位共用一个栅格。
                四个主页控件都是这里的直接子元素，布局方案里给了百分比坐标的会改成
                「铺满整格的左上对齐 + Margin + 显式宽高」，于是等价于绝对定位（见 PageHome.xaml.cs）。
                没给坐标的元素保持下面的行列设置，照常走流式布局。
            -->
            <Grid x:Name="PanHomeStage"
                  Grid.Row="1"
                  Margin="0,10,0,0"
                  ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 没有实例：引导去实例页（悬停时轻微上浮，与另外三张卡一致） -->
                <c:SurfaceCard x:Name="CardEmpty"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               MouseEnter="OnCardEnter"
                               MouseLeave="OnCardLeave"
                               Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{StaticResource Radius.Card}">
                            <svg:SvgIcon Width="26"
                                         Height="26"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="lucide/package-plus"
                                         IconBrush="{DynamicResource Accent.Base}" />
                        </Border>

                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="还没有可启动的游戏实例" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="创建一个实例，指向你的心灵终结游戏目录即可开始。" />

                        <c:OutlineButton Margin="0,16,0,0"
                                         HorizontalAlignment="Center"
                                         Tone="Solid"
                                         Click="OnGoCreateClick">
                            <StackPanel Orientation="Horizontal">
                                <svg:SvgIcon Width="15"
                                             Height="15"
                                             VerticalAlignment="Center"
                                             Icon="lucide/circle-plus"
                                             IconBrush="{DynamicResource Text.OnAccent}" />
                                <TextBlock Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="去创建实例" />
                            </StackPanel>
                        </c:OutlineButton>
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 有实例：当前实例 + 启动按钮 -->
                <c:SurfaceCard x:Name="CardCurrent"
                               Grid.Row="0"
                               Grid.Column="0"
                               Title="当前实例"
                               MouseEnter="OnCardEnter"
                               MouseLeave="OnCardLeave">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock x:Name="LabInstanceName"
                                       MaxWidth="320"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border x:Name="BorState"
                                    Margin="8,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{StaticResource Radius.Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 状态点：就绪=绿、目录失效=红、游戏运行中=强调色（并缓慢呼吸） -->
                                    <Border x:Name="BorStateDot"
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Status.Success}"
                                            CornerRadius="{StaticResource Radius.Pill}" />
                                    <TextBlock x:Name="LabState"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent.Base}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="13"
                                         Height="13"
                                         VerticalAlignment="Center"
                                         Icon="lucide/folder-open"
                                         IconBrush="{DynamicResource Text.Tertiary}" />

                            <TextBlock x:Name="LabPath"
                                       Grid.Column="1"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock x:Name="LabSummary"
                                   Grid.Row="2"
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="LabNote"
                                   Grid.Row="3"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap" />

                        <!-- 上次启动时间：随实例落盘，重启程序后仍在 -->
                        <Grid Grid.Row="4" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="12"
                                         Height="12"
                                         VerticalAlignment="Center"
                                         Icon="lucide/rotate-ccw"
                                         IconBrush="{DynamicResource Text.Tertiary}" />

                            <TextBlock x:Name="LabLastLaunch"
                                       Grid.Column="1"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <c:OutlineButton x:Name="BtnLaunch"
                                         Grid.Row="6"
                                         Height="44"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Tone="Solid"
                                         Click="OnLaunchClick"
                                         MouseEnter="OnLaunchHover"
                                         MouseLeave="OnLaunchLeave">
                            <StackPanel Orientation="Horizontal">
                                <svg:SvgIcon x:Name="IconLaunch"
                                             Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Icon="lucide/play"
                                             IconBrush="{DynamicResource Text.OnAccent}" />
                                <TextBlock x:Name="LabLaunch"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="启动游戏" />
                            </StackPanel>
                        </c:OutlineButton>

                        <TextBlock x:Name="LabLaunchHint"
                                   Grid.Row="7"
                                   Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Status.Warn}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>
                </c:SurfaceCard>

                <!-- 有实例：切换当前实例 -->
                <c:SurfaceCard x:Name="CardSwitch"
                               Grid.Row="0"
                               Grid.Column="2"
                               Title="切换实例"
                               MouseEnter="OnCardEnter"
                               MouseLeave="OnCardLeave">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PanSwitch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 悬停时底色变化（样式触发）+ 轻微右移（AnimationEngine 补间） -->
                                        <Border Margin="0,0,0,6"
                                                Padding="9,8"
                                                CornerRadius="{StaticResource Radius.Item}"
                                                Cursor="Hand"
                                                MouseEnter="OnSwitchRowEnter"
                                                MouseLeave="OnSwitchRowLeave"
                                                MouseLeftButtonUp="OnSwitchRowClick"
                                                Tag="{Binding Instance}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Accent.Faint}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Surface.CardHover}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.RenderTransform>
                                                <TranslateTransform />
                                            </Border.RenderTransform>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Surface.Card}"
                                                        CornerRadius="{StaticResource Radius.Small}">
                                                    <Grid>
                                                        <Image Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding IconImage}"
                                                               Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}" />

                                                        <svg:SvgIcon Width="13"
                                                                     Height="13"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Icon="{Binding Icon}"
                                                                     IconBrush="{DynamicResource Text.Secondary}"
                                                                     Visibility="{Binding HasFallbackIcon, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Margin="9,0,8,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding GameDir}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding GameDir}" />
                                                </StackPanel>

                                                <svg:SvgIcon Grid.Column="2"
                                                             Width="15"
                                                             Height="15"
                                                             VerticalAlignment="Center"
                                                             Icon="lucide/circle-check"
                                                             IconBrush="{DynamicResource Accent.Base}"
                                                             Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="LabSwitchEmpty"
                                   Grid.Row="1"
                                   Margin="0,10,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="只有一个实例，点「游戏实例」页的新建实例可添加更多。"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </Grid>
                </c:SurfaceCard>

                <!-- 有实例：底部提示（保持克制，只做弱提示） -->
                <Border x:Name="CardNote"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,10,0,0"
                        Padding="12,9"
                        Background="{DynamicResource Accent.Faint}"
                        CornerRadius="{StaticResource Radius.Item}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <svg:SvgIcon Grid.Column="0"
                                     Width="13"
                                     Height="13"
                                     Margin="0,1,0,0"
                                     VerticalAlignment="Top"
                                     Icon="lucide/info"
                                     IconBrush="{DynamicResource Accent.Base}" />

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="启动前请确认已安装所需的插件包；游戏输出会记录在「运行日志」页的「游戏日志」标签里。" />
                    </Grid>
                </Border>
            </Grid>

            <!--
                简洁模式浮层：整页只留这一块——右下角一个「启动游戏」按钮，旁边一个小箭头
                点开实例列表直接切换。放在内容栅格里（跨三行、右下对齐），因此不必改动页面结构；
                内容装得下时它正好贴着可视区右下角，其余区域全部留空，以便尽量露出背景图。
            -->
            <Border x:Name="PanSimple"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Padding="12,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Surface.PanelGlass}"
                    CornerRadius="{StaticResource Radius.Card}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LabSimpleInstance"
                               MaxWidth="240"
                               Margin="2,0,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnSimpleLaunch"
                                         Height="40"
                                         Tone="Solid"
                                         Click="OnSimpleLaunchClick">
                            <StackPanel Orientation="Horizontal">
                                <svg:SvgIcon x:Name="IconSimpleLaunch"
                                             Width="16"
                                             Height="16"
                                             VerticalAlignment="Center"
                                             Icon="lucide/play"
                                             IconBrush="{DynamicResource Text.OnAccent}" />
                                <TextBlock x:Name="LabSimpleLaunch"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="启动游戏" />
                            </StackPanel>
                        </c:OutlineButton>

                        <c:RoundIconButton x:Name="BtnSimpleSwitch"
                                           Width="40"
                                           Height="40"
                                           Margin="6,0,0,0"
                                           Icon="lucide/chevron-up"
                                           IconSize="16"
                                           Tone="Plain"
                                           ToolTip="切换实例"
                                           Click="OnSimpleSwitchClick" />

                        <!-- 实例切换菜单：向上弹出，点一项即设为当前实例 -->
                        <Popup x:Name="PopSimpleSwitch"
                               AllowsTransparency="True"
                               Placement="Top"
                               PlacementTarget="{Binding ElementName=BtnSimpleSwitch}"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Margin="0,0,0,8"
                                    Padding="6"
                                    Background="{DynamicResource Surface.Card}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}">
                                <ScrollViewer MaxHeight="320"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PanSimpleSwitch" MinWidth="220">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,4"
                                                        Padding="9,7"
                                                        CornerRadius="{StaticResource Radius.Item}"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="OnSimpleSwitchItemClick"
                                                        Tag="{Binding Instance}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Accent.Faint}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Surface.CardHover}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <svg:SvgIcon Grid.Column="1"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Margin="10,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     Icon="lucide/circle-check"
                                                                     IconBrush="{DynamicResource Accent.Base}"
                                                                     Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</c:LauncherPage>
