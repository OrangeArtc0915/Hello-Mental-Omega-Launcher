<c:LauncherPage xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Pages.PageDownload"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:HMOL.App.Controls"
                xmlns:svg="clr-namespace:HMOL.App.Controls.Svg">

    <c:LauncherPage.Resources>
        <Style x:Key="DlHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </c:LauncherPage.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <c:PageHeader x:Name="HeaderDownload"
                      Grid.Row="0"
                      Title="{loc:T '下载'}"
                      Subtitle="{loc:T '运行库（组网组件 / 7-Zip）与启动器补丁的下载入口'}"
                      Icon="lucide/download" />

        <!-- 下载目录：只作用于下面「更多下载」里的文件 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{loc:T '下载目录'}" />

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface.Sunken}"
                    CornerRadius="{DynamicResource Radius.Item}">
                <TextBlock x:Name="LabDownloadDir"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Border>

            <c:OutlineButton x:Name="BtnChangeDownloadDir"
                             Grid.Column="2"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Content="{loc:T '更改'}"
                             Click="OnChangeDownloadDirClick" />

            <c:OutlineButton x:Name="BtnOpenDownloadDir"
                             Grid.Column="3"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Content="{loc:T '打开'}"
                             Click="OnOpenDownloadDirClick" />
        </Grid>

        <!-- 免责提示：只提供运行库和启动器补丁 -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource Status.WarnSoft}"
                CornerRadius="{DynamicResource Radius.Item}">
            <StackPanel Orientation="Horizontal">
                <svg:SvgIcon Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/triangle-alert"
                             IconBrush="{DynamicResource Status.Warn}" />
                <TextBlock Margin="10,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap"
                           Text="{loc:T '提示：只提供运行库和启动器补丁，不提供任何游戏资源！'}" />
            </StackPanel>
        </Border>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{DynamicResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />
                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />
                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="4"
                      Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 运行环境：组网组件这类运行时单独放最上面，带一键补全 -->
                <c:SurfaceCard x:Name="CardRuntime"
                               Title="{loc:T '运行环境'}"
                               UseShadow="False"
                               HasHoverEffect="False"
                               Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabRuntimeHint"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource DlHint}" />
                            <c:OutlineButton x:Name="BtnCompleteRuntime"
                                             Grid.Column="1"
                                             Margin="8,0,0,0"
                                             Content="{loc:T '一键补全'}"
                                             Tone="Solid"
                                             Click="OnCompleteRuntimeClick" />
                        </Grid>
                        <c:OutlineButton x:Name="BtnToggleRuntime"
                                         Margin="0,10,0,0"
                                         HorizontalAlignment="Left"
                                         Content="{loc:T '展开组件列表'}"
                                         Click="OnToggleRuntimeClick" />

                        <StackPanel x:Name="PanRuntimeItems" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 一键刷新：条目全部由仓库 survive 分支的 download.json 决定，这里只是重新拉一次 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabManifestHint"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource DlHint}" />
                    <c:OutlineButton x:Name="BtnManifestRefresh"
                                     Grid.Column="1"
                                     Margin="8,0,0,0"
                                     Content="{loc:T '刷新列表'}"
                                     Click="OnManifestRefreshClick" />
                </Grid>

                <!-- 分组区块：按 download.json 里每条自己的 group 自动生成（每组一张可折叠卡片） -->
                <StackPanel x:Name="PanGroups" Margin="0,12,0,0" />

                <!-- 说明 -->
                <c:SurfaceCard Margin="0,14,0,0" Title="{loc:T '说明'}" UseShadow="False" HasHoverEffect="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DlHint}"
                                   Text="{loc:T '联机需要组网组件（EasyTier / n2n / TAP 等，按方案下载到启动器目录的 runtime\ 下）与樱花 Frp 引擎（frpc，用樱花方案连接时自动下载）。'}" />
                        <TextBlock Style="{StaticResource DlHint}"
                                   Margin="0,6,0,0"
                                   Text="{loc:T '本页内容全部来自仓库 survive 分支的 download.json：往里面加条目、改分组或地址，点「刷新列表」即可生效，不用等启动器发新版本。'}" />
                        <TextBlock Style="{StaticResource DlHint}"
                                   Margin="0,6,0,0"
                                   Text="{loc:T '下载线路与启动器更新共用（设置 → 更新线路）：一个源失败会自动换另一个。大文件会分片并发下载，下完自动合并（可在「设置 → 程序更新」里关闭多线程）。多分卷会按顺序合并成一个文件。'}" />
                    </StackPanel>
                </c:SurfaceCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</c:LauncherPage>
