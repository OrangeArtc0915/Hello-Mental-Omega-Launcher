<c:LauncherPage x:Class="HMOL.App.Pages.PageSettings"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:HMOL.App.Controls"
                xmlns:svg="clr-namespace:HMOL.App.Controls.Svg"
                xmlns:core="clr-namespace:HMOL.Core.App;assembly=HMOL.Core">

    <c:LauncherPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 滑块：轨道条 + 滑块柄，配色一律用语义资源键，跟着主题与强调色走 -->
        <Style x:Key="SettingSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource Accent.Bright}"
                                 Stroke="{DynamicResource Surface.Card}"
                                 StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑块左边的已选区间 -->
        <Style x:Key="SettingSliderFill" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Accent.Bright}"
                                CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑块右边的未选区间 -->
        <Style x:Key="SettingSliderRest" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <!-- 点哪跳哪，比只认拖动好用 -->
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SettingSliderFill}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingSliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SettingSliderRest}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </c:LauncherPage.Resources>

    <ScrollViewer x:Name="ScrollCategory"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,16">
            <!-- 页头：与其余页面同一形态（本页没有页级操作按钮） -->
            <c:PageHeader x:Name="HeaderSettings"
                          Title="设置"
                          Subtitle="外观、背景与音乐；改动立即生效并自动保存"
                          Icon="lucide/settings" />

            <!--
                以下都是设置分类卡片：全部叠在同一个 Grid 格子里，同一时刻只显示选中的那一张
                （显隐切换见 PageSettings.SwitchCategory，选中态由窗口侧栏负责）。
                折叠的卡片不参与布局，所以各卡片上留的 14px 间距只对当前显示的那张生效。
            -->
            <Grid>
            <!-- 外观 -->
            <c:SurfaceCard x:Name="CardAppearance" Margin="0,14,0,0" Title="外观">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="明暗模式" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnThemeLight"
                                         Tag="Light"
                                         Content="浅色"
                                         Click="OnThemeModeClick" />
                        <c:OutlineButton x:Name="BtnThemeDark"
                                         Margin="8,0,0,0"
                                         Tag="Dark"
                                         Content="深色"
                                         Click="OnThemeModeClick" />
                        <c:OutlineButton x:Name="BtnThemeSystem"
                                         Margin="8,0,0,0"
                                         Tag="System"
                                         Content="跟随系统"
                                         Click="OnThemeModeClick" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="强调色" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnAccentDefault"
                                         Tag="Default"
                                         Content="默认"
                                         Click="OnAccentClick" />
                        <c:OutlineButton x:Name="BtnAccentBlue"
                                         Margin="8,0,0,0"
                                         Tag="Blue"
                                         Content="湖蓝"
                                         Click="OnAccentClick" />
                        <c:OutlineButton x:Name="BtnAccentGreen"
                                         Margin="8,0,0,0"
                                         Tag="Green"
                                         Content="青绿"
                                         Click="OnAccentClick" />
                        <c:OutlineButton x:Name="BtnAccentPurple"
                                         Margin="8,0,0,0"
                                         Tag="Purple"
                                         Content="紫罗兰"
                                         Click="OnAccentClick" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="色板预览" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Border Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Accent.Deep}"
                                CornerRadius="{StaticResource Radius.Small}" />
                        <Border Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Accent.Base}"
                                CornerRadius="{StaticResource Radius.Small}" />
                        <Border Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Accent.Bright}"
                                CornerRadius="{StaticResource Radius.Small}" />
                        <Border Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Accent.Hover}"
                                CornerRadius="{StaticResource Radius.Small}" />
                        <Border Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Background="{DynamicResource Accent.Soft}"
                                CornerRadius="{StaticResource Radius.Small}" />
                        <Border Width="34"
                                Height="34"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{StaticResource Radius.Small}" />
                    </StackPanel>

                    <!-- 窗口透明度：作用于主窗口整体，拖动即时生效 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="窗口透明度" />
                        <Slider x:Name="SldOpacity"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Minimum="0.5"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnWindowOpacityChanged" />
                        <TextBlock x:Name="LabOpacity"
                                   Grid.Column="2"
                                   Width="44"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>

                    <!-- 界面缩放：作用于主界面整体（LayoutTransform），拖动即时生效 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="界面缩放" />
                        <Slider x:Name="SldScale"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Minimum="0.8"
                                Maximum="1.5"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnUiScaleChanged" />
                        <TextBlock x:Name="LabScale"
                                   Grid.Column="2"
                                   Width="44"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>
                    <!-- 卡片 / 组件透明度：只改承载面底色的 alpha，文字与图标保持清晰 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="卡片透明度" />
                        <Slider x:Name="SldSurfaceOpacity"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Minimum="0.3"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnSurfaceOpacityChanged" />
                        <TextBlock x:Name="LabSurfaceOpacity"
                                   Grid.Column="2"
                                   Width="44"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="窗口透明度越低整个窗口越透（含文字，最低 50%）；卡片透明度只让卡片、侧栏与标题栏等承载面变透，文字图标保持清晰（最低 30%）；缩放会等比放大 / 缩小整个界面。均立即生效并自动保存。" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 联机设置：昵称 + 游戏内 HUD -->
            <c:SurfaceCard x:Name="CardNickname" Margin="0,14,0,0" Title="联机设置">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="联机昵称（与 CnCNet 客户端的玩家名共用同一个值，留空表示还没设置）" />
                    <Border Height="34"
                            Margin="0,8,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}">
                        <TextBox x:Name="TxtNickname"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnNicknameChanged" />
                    </Border>
                    <c:OutlineButton x:Name="BtnSaveNickname"
                                     Margin="0,8,0,0"
                                     HorizontalAlignment="Left"
                                     Content="保存昵称"
                                     Tone="Solid"
                                     Click="OnSaveNicknameClick" />
                    <TextBlock x:Name="LabNicknameHint"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />

                    <!-- 游戏内 HUD：置顶小浮窗，可在这里直接开 / 关，方便调试 -->
                    <Border Height="1"
                            Margin="0,14,0,0"
                            Background="{DynamicResource Border.Default}" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="游戏内 HUD" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnHudToggle"
                                         Content="打开游戏 HUD"
                                         Tone="Solid"
                                         Click="OnHudToggleClick" />
                        <TextBlock x:Name="LabHudStatus"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 游戏内 HUD 的透明度：整块（底色 + 文字）一起变，与窗口/卡片透明度互不影响 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="HUD 透明度" />
                        <Slider x:Name="SldHudOpacity"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Minimum="0.4"
                                Maximum="1"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnHudOpacityChanged" />
                        <TextBlock x:Name="LabHudOpacity"
                                   Grid.Column="2"
                                   Width="44"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="只影响游戏内那个置顶浮窗（含文字与底色），最低 40%；与「外观」里的窗口透明度、卡片透明度互不影响。改完立即生效并自动保存。" />

                    <!-- 樱花FRP 内嵌面板：可选功能，依赖本机的 WebView2 运行时 -->
                    <Border Height="1"
                            Margin="0,14,0,0"
                            Background="{DynamicResource Border.Default}" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="樱花FRP 内嵌面板" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnSakuraPanel"
                                         Content="未启用"
                                         Click="OnSakuraPanelToggleClick" />
                        <TextBlock x:Name="LabSakuraPanel"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </c:SurfaceCard>

            <!-- 天气城市 -->
            <c:SurfaceCard x:Name="CardWeatherCity" Margin="0,14,0,0" Title="天气城市">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="主页天气小组件显示的城市，填城市名即可（如「北京」「上海」）" />
                    <Border Height="34"
                            Margin="0,8,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}">
                        <TextBox x:Name="TxtWeatherCity"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnWeatherCityChanged" />
                    </Border>

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnSaveWeatherCity"
                                         Content="保存城市"
                                         Tone="Solid"
                                         Click="OnSaveWeatherCityClick" />
                        <c:OutlineButton x:Name="BtnCheckWeatherCity"
                                         Margin="8,0,0,0"
                                         Content="验证城市"
                                         Click="OnCheckWeatherCityClick" />
                    </StackPanel>

                    <TextBlock x:Name="LabWeatherCityHint"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="天气数据来自 Open-Meteo（免费、无需 Key）：城市名先由它的地理编码服务解析成经纬度，再取实时天气。主页 30 分钟内复用缓存，点天气卡右上角的刷新按钮可强制更新。" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 常用网站 -->
            <c:SurfaceCard x:Name="CardSites" Margin="0,14,0,0" Title="常用网站">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="主页「常用网站」小组件里显示的站点，点击后用系统默认浏览器打开" />

                    <ScrollViewer Margin="0,8,0,0"
                                  MaxHeight="170"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListSites">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,6,4,6"
                                            Background="{DynamicResource Surface.Sunken}"
                                            CornerRadius="{StaticResource Radius.Item}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <svg:SvgIcon Grid.Column="0"
                                                         Width="13"
                                                         Height="13"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/link-2"
                                                         IconBrush="{DynamicResource Text.Tertiary}" />

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding Url}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Url}" />
                                            </StackPanel>

                                            <c:RoundIconButton Grid.Column="2"
                                                               Width="26"
                                                               Height="26"
                                                               Icon="lucide/trash-2"
                                                               Tag="{Binding Index}"
                                                               Tone="Danger"
                                                               ToolTip="移除这个网站"
                                                               Click="OnRemoveSiteClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="LabSitesEmptyHint"
                               Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               Text="列表是空的，下面添加几个，或点「恢复默认列表」。"
                               Visibility="Collapsed" />

                    <!-- 添加一行：名称 + 网址 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="34"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}">
                            <TextBox x:Name="TxtSiteName"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     ToolTip="显示名称" />
                        </Border>

                        <Border Grid.Column="2"
                                Height="34"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}">
                            <TextBox x:Name="TxtSiteUrl"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     ToolTip="网址，http / https" />
                        </Border>

                        <c:OutlineButton Grid.Column="4"
                                         Content="添加"
                                         Tone="Solid"
                                         Click="OnAddSiteClick" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="名称与网址都填好才能添加；网址只允许 http / https（不写协议时按 https 补全）。" />

                    <c:OutlineButton x:Name="BtnRestoreSites"
                                     Margin="0,10,0,0"
                                     HorizontalAlignment="Left"
                                     Content="恢复默认列表"
                                     Click="OnRestoreSitesClick" />

                    <TextBlock x:Name="LabSitesHint"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 主页背景 -->
            <c:SurfaceCard x:Name="CardBackground" Margin="0,14,0,0" Title="主页背景">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="当前背景" />
                    <TextBlock x:Name="LabBackground"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap"
                               Text="未设置，使用主题渐变。" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnPickBackground"
                                         Content="选择图片 / 动图 / 视频"
                                         Tone="Solid"
                                         Click="OnPickBackgroundClick" />
                        <c:OutlineButton x:Name="BtnImportWallpaper"
                                         Margin="8,0,0,0"
                                         Content="导入壁纸包"
                                         Click="OnImportWallpaperClick" />
                        <c:OutlineButton x:Name="BtnClearBackground"
                                         Margin="8,0,0,0"
                                         Content="清除背景"
                                         Tone="Danger"
                                         Click="OnClearBackgroundClick" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="壁纸包指 Wallpaper Engine 导出的 .pkg / .mpkg，导入时会用内置工具解包并取其中的视频或图片。素材都会复制进数据目录，原文件删掉也不影响。" />
                    <TextBlock x:Name="LabBackgroundStatus"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="模糊程度" />
                        <Slider x:Name="SldBlur"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Maximum="30"
                                SmallChange="1"
                                LargeChange="5"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnBackgroundBlurChanged" />
                        <TextBlock x:Name="LabBlur"
                                   Grid.Column="2"
                                   Width="40"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="暗化程度" />
                        <Slider x:Name="SldDim"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Maximum="80"
                                SmallChange="5"
                                LargeChange="10"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnBackgroundDimChanged" />
                        <TextBlock x:Name="LabDim"
                                   Grid.Column="2"
                                   Width="40"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="背景铺满整个窗口（含标题栏与侧栏），界面面板是半透明的。视频背景只做暗化、不做模糊。" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 背景音乐 -->
            <c:SurfaceCard x:Name="CardMusic" Margin="0,14,0,0" Title="背景音乐">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="启用背景音乐" />
                        <c:OutlineButton x:Name="BtnBgmEnabled"
                                         Margin="10,0,0,0"
                                         Tag="Enabled"
                                         Click="OnBgmToggleClick" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="开启后随程序启动自动播放列表里的曲目；以开机自启方式启动时只驻留托盘，等打开主窗口后再播放。" />

                    <TextBlock x:Name="LabBgmNow"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap"
                               Text="未播放" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <c:RoundIconButton x:Name="BtnBgmPrev"
                                           Icon="lucide/arrow-left"
                                           ToolTip="上一首"
                                           Click="OnBgmPreviousClick" />
                        <c:OutlineButton x:Name="BtnBgmPlayPause"
                                         Margin="8,0,0,0"
                                         MinWidth="76"
                                         Content="播放"
                                         Click="OnBgmPlayPauseClick" />
                        <c:RoundIconButton x:Name="BtnBgmNext"
                                           Margin="8,0,0,0"
                                           Icon="lucide/arrow-right"
                                           ToolTip="下一首"
                                           Click="OnBgmNextClick" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="音量" />
                        <Slider x:Name="SldVolume"
                                Grid.Column="1"
                                Margin="8,0,8,0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                Style="{StaticResource SettingSlider}"
                                ValueChanged="OnBgmVolumeChanged" />
                        <TextBlock x:Name="LabVolume"
                                   Grid.Column="2"
                                   Width="40"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextAlignment="Right" />
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnBgmLoop"
                                         Tag="Loop"
                                         Click="OnBgmToggleClick" />
                        <c:OutlineButton x:Name="BtnBgmShuffle"
                                         Margin="8,0,0,0"
                                         Tag="Shuffle"
                                         Click="OnBgmToggleClick" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="播放列表" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnBgmAdd"
                                         Content="添加曲目"
                                         Tone="Solid"
                                         Click="OnBgmAddClick" />
                        <c:OutlineButton x:Name="BtnBgmRemoveCurrent"
                                         Margin="8,0,0,0"
                                         Content="移除当前曲目"
                                         Click="OnBgmRemoveCurrentClick" />
                    </StackPanel>

                    <ScrollViewer Margin="0,8,0,0"
                                  MaxHeight="150"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListBgm">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,4,4,4"
                                            CornerRadius="{StaticResource Radius.Item}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                <Style.Triggers>
                                                    <!-- 当前曲目高亮一下，免得用户看不出放到哪首了 -->
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Accent.Faint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <svg:SvgIcon Grid.Column="0"
                                                         Width="13"
                                                         Height="13"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/music"
                                                         IconBrush="{DynamicResource Text.Tertiary}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}" />
                                            <c:RoundIconButton Grid.Column="2"
                                                               Width="26"
                                                               Height="26"
                                                               Icon="lucide/trash-2"
                                                               Tag="{Binding Index}"
                                                               Tone="Danger"
                                                               ToolTip="移除这首"
                                                               Click="OnBgmRemoveRowClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="LabBgmHint"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 界面布局 -->
            <c:SurfaceCard x:Name="CardLayout" Margin="0,14,0,0" Title="界面布局">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="当前方案" />
                    <TextBlock x:Name="LabLayoutScheme"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnOpenLayoutEditor"
                                         Content="打开布局编辑器"
                                         Tone="Solid"
                                         Click="OnOpenLayoutEditorClick" />
                        <c:OutlineButton x:Name="BtnResetLayout"
                                         Margin="8,0,0,0"
                                         Content="恢复默认布局"
                                         Tone="Danger"
                                         Click="OnResetLayoutClick" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="编辑器里可调整左侧导航的顺序、显隐与名称。编辑过程不影响主界面，点「保存并应用」后立即生效；方案存在数据目录的 layouts 子目录下。" />
                    <TextBlock x:Name="LabLayoutStatus"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />

                    <!-- 主页小组件显隐：日历 / 天气 / 常用网站，关掉就不在主页出现 -->
                    <TextBlock Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="主页小组件" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnWidgetCalendar"
                                         Tag="Calendar"
                                         Click="OnWidgetToggleClick" />
                        <c:OutlineButton x:Name="BtnWidgetWeather"
                                         Margin="8,0,0,0"
                                         Tag="Weather"
                                         Click="OnWidgetToggleClick" />
                        <c:OutlineButton x:Name="BtnWidgetSites"
                                         Margin="8,0,0,0"
                                         Tag="Sites"
                                         Click="OnWidgetToggleClick" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="关掉的组件会从主页拿掉，空出来的位置也会一并收掉；组件自己的内容（如网站清单）仍保留在设置里，随时可以再打开。" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 扩展模块：声明式小组件扩展的增删改、启停与目录入口 -->
            <c:SurfaceCard x:Name="CardExtensions" Margin="0,14,0,0" Title="扩展模块">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="扩展是一份 JSON 清单（纯声明式配置），用来描述一个主页小组件：标题、图标、文字行、可选的数据源与点击网址。它不会执行任何代码，也不会碰你电脑上的文件。" />

                    <!-- 安全说明必须显眼：这是本机制的安全边界 -->
                    <Border Margin="0,8,0,0"
                            Padding="10,8"
                            Background="{DynamicResource Status.WarnSoft}"
                            CornerRadius="{StaticResource Radius.Item}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="14"
                                         Height="14"
                                         Margin="0,1,0,0"
                                         VerticalAlignment="Top"
                                         Icon="lucide/shield-check"
                                         IconBrush="{DynamicResource Status.Warn}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="安全说明：扩展不会被「执行」。启动器不加载任何程序集、不引入脚本引擎，只把清单里的文字画到卡片上；扩展目录只被读取，启动器也不会为扩展写缓存文件、不会改注册表。数据源仅做 http/https 的只读 GET，并有超时与内存缓存。" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="扩展目录" />
                    <TextBlock x:Name="LabExtensionsPath"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Accent.Base}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="扩展目录下的每个 .json 文件就是一个扩展（一个文件 = 一个扩展）。用「新建 / 编辑」按表单填，保存前会做同一套校验并给出可读原因；也可以直接手写清单，写完点「重新加载」。字段说明与示例见 docs/extensions.md 与 docs/extensions/示例.json。" />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnNewExtension"
                                         Content="新建扩展"
                                         Tone="Solid"
                                         Click="OnNewExtensionClick" />
                        <c:OutlineButton x:Name="BtnReloadExtensions"
                                         Margin="8,0,0,0"
                                         Content="重新加载"
                                         Click="OnReloadExtensionsClick" />
                        <c:OutlineButton x:Name="BtnOpenExtensionsFolder"
                                         Margin="8,0,0,0"
                                         Content="打开扩展目录"
                                         Click="OnOpenExtensionsFolderClick" />
                    </StackPanel>

                    <!-- 数据源联网总开关：关掉后扩展只显示清单里写死的静态内容 -->
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="数据源联网总开关" />
                        <c:OutlineButton x:Name="BtnExtensionNetwork"
                                         Margin="10,0,0,0"
                                         Click="OnToggleExtensionNetworkClick" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="关闭后扩展只显示清单里写死的静态内容。" />
                    </StackPanel>

                    <!-- 已发现的扩展列表：名称 / 版本 / 作者 / 状态 + 启用停用 -->
                    <ScrollViewer x:Name="ScrollExtensions"
                                  Margin="0,12,0,0"
                                  MaxHeight="260"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListExtensions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10,8"
                                            Background="{DynamicResource Surface.Sunken}"
                                            CornerRadius="{StaticResource Radius.Item}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="26"
                                                    Height="26"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource Surface.Card}"
                                                    CornerRadius="{StaticResource Radius.Small}">
                                                <svg:SvgIcon Width="14"
                                                             Height="14"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Icon="lucide/puzzle"
                                                             IconBrush="{DynamicResource Accent.Base}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.AutomationId="{Binding Id}"
                                                           AutomationProperties.Name="{Binding A11yName}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding MetaText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                                                <!-- 状态：已启用绿、加载失败红、已停用弱色 -->
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="11.5"
                                                           Text="{Binding StatusText}"
                                                           AutomationProperties.Name="{Binding StatusA11yName}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Status.Danger}"
                                                           Text="{Binding ErrorText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <c:RoundIconButton Width="26"
                                                                   Height="26"
                                                                   Icon="lucide/pencil"
                                                                   Tag="{Binding}"
                                                                   Tone="Plain"
                                                                   ToolTip="编辑这份清单"
                                                                   AutomationProperties.AutomationId="{Binding EditId}"
                                                                   AutomationProperties.Name="{Binding EditA11yName}"
                                                                   Click="OnEditExtensionClick" />
                                                <c:RoundIconButton Width="26"
                                                                   Height="26"
                                                                   Margin="4,0,0,0"
                                                                   Icon="lucide/power"
                                                                   Tag="{Binding}"
                                                                   Tone="{Binding ToggleTone}"
                                                                   ToolTip="{Binding ToggleTip}"
                                                                   AutomationProperties.AutomationId="{Binding ToggleId}"
                                                                   AutomationProperties.Name="{Binding ToggleA11yName}"
                                                                   Click="OnToggleExtensionClick" />
                                                <c:RoundIconButton Width="26"
                                                                   Height="26"
                                                                   Margin="4,0,0,0"
                                                                   Icon="lucide/trash-2"
                                                                   Tag="{Binding}"
                                                                   Tone="Danger"
                                                                   ToolTip="删除这份清单"
                                                                   AutomationProperties.AutomationId="{Binding DeleteId}"
                                                                   AutomationProperties.Name="{Binding DeleteA11yName}"
                                                                   Click="OnDeleteExtensionClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态：说明扩展目录在哪、怎么建第一个扩展 -->
                    <StackPanel x:Name="PanExtensionsEmpty"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                        <TextBlock FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="还没有任何扩展。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="点「新建扩展」用表单建一个；也可以把 docs/extensions/示例.json 复制到扩展目录里，再点「重新加载」。" />
                    </StackPanel>

                    <TextBlock x:Name="LabExtensionsHint"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 开机自启 -->
            <c:SurfaceCard x:Name="CardAutoStart" Margin="0,14,0,0" Title="开机自启">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="登录系统后自动启动" />
                        <c:OutlineButton x:Name="BtnAutoStart"
                                         Margin="10,0,0,0"
                                         Click="OnAutoStartClick" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="自启后只驻留系统托盘，不弹出主窗口；点托盘图标或托盘菜单里的「显示主窗口」才会打开界面。" />
                    <TextBlock x:Name="LabAutoStartStatus"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 游戏路径：目录属于每个实例，在「游戏实例」页管理；向导可随时重跑 -->
            <c:SurfaceCard x:Name="CardGamePath" Margin="0,14,0,0" Title="游戏路径">
                <StackPanel>
                    <TextBlock FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="游戏目录属于每个游戏实例，请在「游戏实例」页新建或编辑实例时指定。" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="首次运行会出现一次配置向导，带你完成「选目录 → 检查环境 → 创建实例」。" />
                    <c:OutlineButton x:Name="BtnRunWizard"
                                     Height="34"
                                     Margin="0,12,0,0"
                                     HorizontalAlignment="Left"
                                     Content="重新运行配置向导"
                                     Tone="Solid"
                                     Click="OnRunWizardClick" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 程序更新：检查启动器本体有没有新版本，并支持一键更新 -->
            <c:SurfaceCard x:Name="CardUpdate" Margin="0,14,0,0" Title="程序更新">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="启动时自动检查更新" />
                        <c:OutlineButton x:Name="BtnAutoCheckUpdate"
                                         Margin="10,0,0,0"
                                         Click="OnAutoCheckUpdateClick" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="开启后每次启动都会在后台查一次新版本；检查失败只写运行日志，不会打扰你。" />

                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="更新线路" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnUpdateSourceAuto"
                                         Tag="Auto"
                                         Content="自动"
                                         Click="OnUpdateSourceClick" />
                        <c:OutlineButton x:Name="BtnUpdateSourceGitHub"
                                         Margin="8,0,0,0"
                                         Tag="GitHub"
                                         Content="GitHub 优先"
                                         Click="OnUpdateSourceClick" />
                        <c:OutlineButton x:Name="BtnUpdateSourceGitee"
                                         Margin="8,0,0,0"
                                         Tag="Gitee"
                                         Content="Gitee 优先"
                                         Click="OnUpdateSourceClick" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="自动：GitHub 取不到时换 Gitee。国内网络下建议选「Gitee 优先」；无论选哪个，取不到都会自动换另一个源。" />

                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="下载加速（多线程）" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <c:OutlineButton x:Name="BtnMultiThreadDownload" Click="OnMultiThreadDownloadClick" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="开启后大文件会分成多段并发下载（需要服务器支持断点续传），对启动器更新、下载页文件等通常更快；个别网络下并发连接会被限速或干扰，可关闭退回单连接。" />

                    <TextBlock x:Name="LabUpdateLastCheck"
                               Margin="0,16,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}" />

                    <c:OutlineButton x:Name="BtnCheckUpdate"
                                     Margin="0,10,0,0"
                                     HorizontalAlignment="Left"
                                     Content="检查启动器更新"
                                     Tone="Solid"
                                     Click="OnCheckUpdateClick" />
                    <TextBlock x:Name="LabUpdateStatus"
                               Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="更新只会替换启动器本身：设置、缓存、实例与游戏文件都不会动。" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 关于与存储 -->
            <c:SurfaceCard x:Name="CardAbout" Margin="0,14,0,0" Title="关于与存储">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="当前版本" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="{x:Static core:AppInfo.VersionDisplay}" />
                    </Grid>

                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="数据目录" />
                    <TextBlock x:Name="LabDataPath"
                               Margin="0,4,0,0"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Accent.Base}"
                               Cursor="Hand"
                               ToolTip="点击打开数据目录"
                               MouseLeftButtonUp="OnOpenDataFolderClick" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="设置、实例、插件包与日志都放在这里；可用环境变量 HMOL_DATA 重定向。" />
                </StackPanel>
            </c:SurfaceCard>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</c:LauncherPage>
