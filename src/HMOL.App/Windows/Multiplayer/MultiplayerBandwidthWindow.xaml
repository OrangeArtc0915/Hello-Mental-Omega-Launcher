<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerBandwidthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="440"
        Height="430"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" Title="带宽测速" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="角色" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnServer"
                                 Tag="server"
                                 Content="本机作为服务端（等对方来测）"
                                 Click="OnRoleClick" />
                <c:OutlineButton x:Name="BtnClient"
                                 Margin="8,0,0,0"
                                 Tag="client"
                                 Content="本机作为客户端"
                                 Click="OnRoleClick" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="对方虚拟 IP（客户端模式必填）" />
            <Border Height="32"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}">
                <TextBox x:Name="TxtHost"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         VerticalContentAlignment="Center" />
            </Border>

            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="测速时长" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnSec3" Tag="3" Content="3 秒" Click="OnSecondsClick" />
                <c:OutlineButton x:Name="BtnSec5" Margin="8,0,0,0" Tag="5" Content="5 秒" Click="OnSecondsClick" />
                <c:OutlineButton x:Name="BtnSec10" Margin="8,0,0,0" Tag="10" Content="10 秒" Click="OnSecondsClick" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnGo" Width="96" Content="开始" Tone="Solid" Click="OnGoClick" />
                <c:OutlineButton x:Name="BtnCancel"
                                 Margin="8,0,0,0"
                                 Width="96"
                                 Content="取消"
                                 IsEnabled="False"
                                 Click="OnCancelClick" />
            </StackPanel>

            <TextBlock x:Name="LabStatus"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="未开始" />

            <ScrollViewer Height="90"
                          Margin="0,8,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanResult" />
            </ScrollViewer>
        </StackPanel>
    </c:SurfaceCard>
</Window>
