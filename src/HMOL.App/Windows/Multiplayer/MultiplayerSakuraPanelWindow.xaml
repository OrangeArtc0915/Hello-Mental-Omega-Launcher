<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerSakuraPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="940"
        Height="700"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" Title="樱花FRP 面板" UseShadow="False">
        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <c:OutlineButton x:Name="BtnBack"
                                 Grid.Column="0"
                                 Padding="10,4"
                                 Content="后退"
                                 FontSize="12"
                                 IsEnabled="False"
                                 Click="OnBackClick" />
                <c:OutlineButton x:Name="BtnForward"
                                 Grid.Column="1"
                                 Margin="6,0,0,0"
                                 Padding="10,4"
                                 Content="前进"
                                 FontSize="12"
                                 IsEnabled="False"
                                 Click="OnForwardClick" />
                <c:OutlineButton x:Name="BtnRefresh"
                                 Grid.Column="2"
                                 Margin="6,0,0,0"
                                 Padding="10,4"
                                 Content="刷新"
                                 FontSize="12"
                                 IsEnabled="False"
                                 Click="OnRefreshClick" />

                <TextBlock x:Name="LabAddress"
                           Grid.Column="3"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border x:Name="PanHost"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}" />

            <TextBlock x:Name="LabError"
                       Grid.Row="1"
                       Margin="14"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>
    </c:SurfaceCard>
</Window>
