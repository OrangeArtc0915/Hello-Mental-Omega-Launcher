<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerNetCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="480"
        Height="470"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" Title="连通性检测" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="汇总 PING / TCP·UDP 测速 / NAT 检测。测速需要一端开服务端、另一端开客户端。" />

            <Border Margin="0,12,0,0"
                    Padding="12,10"
                    Background="{DynamicResource Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.Item}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="PING 测试" />
                        <TextBlock FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="验证两台机器能否互通及延迟" />
                    </StackPanel>
                    <c:OutlineButton Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Content="进入"
                                     Tag="ping"
                                     Click="OnEntryClick" />
                </Grid>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,10"
                    Background="{DynamicResource Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.Item}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="TCP 测速" />
                        <TextBlock FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="测试虚拟局域网内的 TCP 带宽" />
                    </StackPanel>
                    <c:OutlineButton Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Content="进入"
                                     Tag="tcp"
                                     Click="OnEntryClick" />
                </Grid>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,10"
                    Background="{DynamicResource Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.Item}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="UDP 测速" />
                        <TextBlock FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="测试虚拟局域网内的 UDP 带宽" />
                    </StackPanel>
                    <c:OutlineButton Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Content="进入"
                                     Tag="udp"
                                     Click="OnEntryClick" />
                </Grid>
            </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,10"
                    Background="{DynamicResource Surface.Sunken}"
                    CornerRadius="{StaticResource Radius.Item}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Text="NAT 检测" />
                        <TextBlock FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="通过 STUN 查看当前网络的 NAT 类型" />
                        <TextBlock x:Name="LabNat"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <c:OutlineButton x:Name="BtnNat"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Content="检测"
                                     Tag="nat"
                                     Click="OnEntryClick" />
                </Grid>
            </Border>
        </StackPanel>
    </c:SurfaceCard>
</Window>
