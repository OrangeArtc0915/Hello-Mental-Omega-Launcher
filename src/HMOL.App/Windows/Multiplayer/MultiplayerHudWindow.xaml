<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Style="{x:Null}"
        Title="联机 HUD"
        AllowsTransparency="True"
        Background="{x:Null}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        SnapsToDevicePixels="True">

    <Border x:Name="Frame"
            MinWidth="186"
            Background="{DynamicResource Surface.CardGlass}"
            BorderBrush="{DynamicResource Border.Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <StackPanel Margin="10,8,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock x:Name="LabTitle"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="联机" />
                    <TextBlock x:Name="LabCount"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>

                <c:RoundIconButton Grid.Column="1"
                                   Width="22"
                                   Height="22"
                                   Icon="lucide/x"
                                   IconSize="11"
                                   Tone="Plain"
                                   ToolTip="隐藏 HUD"
                                   Click="OnHideClick" />
            </Grid>

            <Border Height="1"
                    Margin="0,6,0,0"
                    Background="{DynamicResource Border.Default}" />

            <StackPanel x:Name="PanRows" Margin="0,6,0,0" />

            <TextBlock x:Name="LabEmpty"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource Text.Tertiary}"
                       Text="暂无对端" />
        </StackPanel>
    </Border>
</Window>
