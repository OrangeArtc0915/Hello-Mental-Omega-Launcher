<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Style="{x:Null}"
        Title="联机 HUD"
        AllowsTransparency="True"
        Background="{x:Null}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource Text.OnHud}"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        SnapsToDevicePixels="True">

    <!--
        HUD 叠在游戏画面上，底色固定为接近纯黑的深色、且不跟主题与「承载面透明度」走：
        否则浅色主题、或把卡片透明度调低时，游戏画面会透上来把字盖住。
        整体通透度只由「设置 → HUD 透明度」这一个滑块单独控制。
    -->
    <Border x:Name="Frame"
            MinWidth="208"
            Background="#FF0B0E13"
            BorderBrush="#FF4A5566"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Card}"
            MouseLeftButtonDown="OnDragAreaMouseDown">
        <StackPanel Margin="11,9,11,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock x:Name="LabTitle"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Text.OnHud}"
                               Text="联机" />
                    <TextBlock x:Name="LabCount"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.OnHudDim}" />
                </StackPanel>

                <c:RoundIconButton x:Name="BtnHudClose"
                                   Grid.Column="1"
                                   Width="24"
                                   Height="24"
                                   Icon="lucide/x"
                                   IconSize="12"
                                   Tone="Plain"
                                   ToolTip="隐藏 HUD"
                                   Click="OnHideClick" />
            </Grid>

            <Border Height="1"
                    Margin="0,7,0,0"
                    Background="{DynamicResource Common.HalfWhite}"
                    Opacity="0.35" />

            <StackPanel x:Name="PanRows" Margin="0,7,0,0" />

            <TextBlock x:Name="LabEmpty"
                       Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.OnHudFaint}"
                       Text="暂无对端" />
        </StackPanel>
    </Border>
</Window>
