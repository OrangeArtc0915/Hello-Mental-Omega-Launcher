<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerSupernodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="460"
        Height="430"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" Title="服务端模式（自建 supernode）" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="本机自建 n2n 节点供远程队友连接。启动后把公网地址发给队友，队友在节点栏填「公网IP:端口」（需要路由器放行该 UDP 端口）。" />

            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="监听端口（1024 - 65535）" />
            <Border Height="32"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    HorizontalAlignment="Left"
                    MinWidth="120"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBox x:Name="TxtPort"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         VerticalContentAlignment="Center" />
            </Border>

            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="自动分配 IP 池（网段/掩码）" />
            <Border Height="32"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBox x:Name="TxtPool"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         VerticalContentAlignment="Center" />
            </Border>

            <Border x:Name="BarAddress"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    Background="{DynamicResource Accent.Faint}"
                    CornerRadius="{StaticResource Radius.Item}"
                    Visibility="Collapsed">
                <TextBlock x:Name="LabAddress"
                           FontFamily="Consolas, Microsoft YaHei UI"
                           FontSize="12"
                           Foreground="{DynamicResource Accent.Base}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="LabStatus"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="未启动" />

            <c:OutlineButton x:Name="BtnToggle"
                             Margin="0,14,0,0"
                             Height="38"
                             Content="启动服务"
                             Tone="Solid"
                             Click="OnToggleClick" />
        </StackPanel>
    </c:SurfaceCard>
</Window>
