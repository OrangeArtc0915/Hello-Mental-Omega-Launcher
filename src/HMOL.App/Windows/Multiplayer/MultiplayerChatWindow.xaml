<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="460"
        Height="540"
        MinWidth="380"
        MinHeight="380"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Margin="12" Padding="0" UseShadow="False">
        <Grid Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="4"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Item}">
                <ScrollViewer x:Name="ScrollHistory"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanHistory" Margin="6,4" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="34"
                        Padding="10,0"
                        Background="{DynamicResource Surface.Sunken}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Button}">
                    <TextBox x:Name="TxtInput"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource Text.Primary}"
                             Foreground="{DynamicResource Text.Primary}"
                             KeyDown="OnInputKeyDown"
                             MaxLength="500"
                             VerticalContentAlignment="Center" />
                </Border>

                <c:OutlineButton x:Name="BtnSend"
                                 Grid.Column="1"
                                 Width="76"
                                 Margin="8,0,0,0"
                                 Content="发送"
                                 Tone="Solid"
                                 Click="OnSendClick" />
            </Grid>

            <TextBlock x:Name="LabHint"
                       Grid.Row="2"
                       Margin="0,8,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="纯文字，500 字以内；禁止发送网址与违禁词。" />
        </Grid>
    </c:SurfaceCard>
</Window>
