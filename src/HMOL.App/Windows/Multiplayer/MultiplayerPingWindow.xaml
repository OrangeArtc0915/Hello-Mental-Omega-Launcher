<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerPingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="420"
        Height="410"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" Title="PING 测试" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="目标 IP 或主机名（可以是对端虚拟 IP）" />

            <Border Height="32"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}">
                <TextBox x:Name="TxtTarget"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         VerticalContentAlignment="Center" />
            </Border>

            <TextBlock Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="次数（1 - 10）" />
            <Border Width="90"
                    Height="32"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}">
                <TextBox x:Name="TxtCount"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         Text="4"
                         VerticalContentAlignment="Center" />
            </Border>

            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnGo"
                                 Width="96"
                                 Content="开始"
                                 Tone="Solid"
                                 Click="OnGoClick" />
                <c:OutlineButton x:Name="BtnCancel"
                                 Margin="8,0,0,0"
                                 Width="96"
                                 Content="取消"
                                 IsEnabled="False"
                                 Click="OnCancelClick" />
            </StackPanel>

            <TextBlock x:Name="LabStatus"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="未开始" />

            <ScrollViewer Height="110"
                          Margin="0,8,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanResult" />
            </ScrollViewer>
        </StackPanel>
    </c:SurfaceCard>
</Window>
