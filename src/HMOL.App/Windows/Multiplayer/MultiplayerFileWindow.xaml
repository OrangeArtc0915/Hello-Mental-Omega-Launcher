<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="660"
        Height="600"
        MinWidth="560"
        MinHeight="480"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,8"
                    Background="{DynamicResource Status.WarnSoft}"
                    CornerRadius="{DynamicResource Radius.Item}">
                <TextBlock FontSize="11.5"
                           Foreground="{DynamicResource Status.Warn}"
                           TextWrapping="Wrap"
                           Text="提示：发送前请先压缩文件（zip / 7z），可大幅提升传输速度；单文件上限 500MB。" />
            </Border>

            <TextBlock Grid.Row="1"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="选择接收方（在线对端，自动刷新）" />
            <ListBox x:Name="ListPeers"
                     Grid.Row="2"
                     Height="120"
                     Margin="0,6,0,0"
                     Padding="2"
                     Background="{DynamicResource Surface.Sunken}"
                     BorderBrush="{DynamicResource Border.Default}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Text.Primary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="{Binding Ip}" />
                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                <c:OutlineButton Content="选择文件" Click="OnPickClick" />
                <TextBlock x:Name="LabFile"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="未选择文件"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnSend"
                                 Content="发 送"
                                 Tone="Solid"
                                 Click="OnSendClick" />
                <c:OutlineButton x:Name="BtnCancel"
                                 Margin="8,0,0,0"
                                 Content="取消"
                                 IsEnabled="False"
                                 Click="OnCancelClick" />
                <TextBlock x:Name="LabStatus"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Secondary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ProgressBar x:Name="Bar" Grid.Row="5" Margin="0,10,0,0" Maximum="1" Value="0" />

            <StackPanel Grid.Row="6" Margin="0,12,0,0">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="传输记录" />
                <ScrollViewer Margin="0,6,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanLog" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </c:SurfaceCard>
</Window>
