<Window x:Class="HMOL.App.Windows.Multiplayer.MultiplayerLagCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="460"
        Height="290"
        Background="{DynamicResource Surface.Window}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Margin="12" Padding="0" Title="心灵终结 CNC 大厅延迟代码" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="在游戏里的聊天框粘贴下面的指令可以调整网络帧发送频率（x 换成实际数字，数值越大发送越频繁）。" />

            <Border Height="36"
                    Margin="0,14,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBox x:Name="TxtCommand"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="12.5"
                         Foreground="{DynamicResource Text.Primary}"
                         IsReadOnly="True"
                         Text="/framesendrate x" />
            </Border>

            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <c:OutlineButton Content="复制指令" Tone="Solid" Click="OnCopyClick" />
                <TextBlock x:Name="LabCopied"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Status.Success}" />
            </StackPanel>
        </StackPanel>
    </c:SurfaceCard>
</Window>
