<Window x:Class="HMOL.App.Windows.PickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="560"
        Height="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="LabSubtitle"
                       Grid.Row="0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap" />

            <!-- 多选模式才有：全选 / 全不选 -->
            <StackPanel x:Name="PanTools"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Orientation="Horizontal">
                <c:OutlineButton Content="全选" Click="OnSelectAllClick" />
                <c:OutlineButton Margin="8,0,0,0" Content="全不选" Click="OnClearAllClick" />
            </StackPanel>

            <!-- 列表可能几百项，必须放在 ScrollViewer 里；窗口高度固定，只有这里滚动 -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Item}">
                <ScrollViewer Margin="4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanItems" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="LabCount"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <c:OutlineButton Width="88"
                                     Height="32"
                                     Content="取消"
                                     Click="OnCancelClick" />
                    <c:OutlineButton x:Name="BtnOk"
                                     Width="88"
                                     Height="32"
                                     Margin="8,0,0,0"
                                     Content="确定"
                                     Tone="Solid"
                                     Click="OnOkClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </c:SurfaceCard>
</Window>
