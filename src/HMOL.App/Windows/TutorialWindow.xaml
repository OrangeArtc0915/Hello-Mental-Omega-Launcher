                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource Accent.Base}" />
                                                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Accent.Base}" Text="{loc:T '欢迎'}" />
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource Border.Default}" />
                                                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}" Text="{loc:T '选择目录'}" />
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource Border.Default}" />
                                                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}" Text="{loc:T '检查环境'}" />
                                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource Border.Default}" />
                                                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Text.Tertiary}" Text="{loc:T '创建实例'}" />
