                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 「关于」里能看版本号、许可与仓库地址'}" />

                                        <!-- 标注 2：左下角新手教程 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 左下角随时能再打开这份新手教程'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 几句话记住 -->
                    <Border x:Name="SecSummary"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/sparkles"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '几句话记住'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 本程序是玩家自制的第三方启动器，与《心灵终结》开发组、EA 均无关联，也不提供游戏本体与官方补丁（请从官网获取）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 许可为 PolyForm Noncommercial 1.0.0：免费用于非商业用途，禁止商用。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 设置、实例、包与日志都放在程序目录的 Data\ 里，把整个目录拷走就能带走全部数据。'}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </c:SurfaceCard>
    </Grid>
</Window>
