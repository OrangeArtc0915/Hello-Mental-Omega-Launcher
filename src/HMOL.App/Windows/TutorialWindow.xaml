                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <c:OutlineButton Content="{loc:T '上一步'}" Padding="12,4" FontSize="11.5" />
