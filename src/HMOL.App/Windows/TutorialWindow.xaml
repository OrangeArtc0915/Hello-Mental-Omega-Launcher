                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '②填房间名（随便取，两边填一样）'}" />

                                        <!-- 标号 3 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '③填密钥（口令，两边填一样）'}" />

                                        <!-- 标号 4 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '④点「进入」开始连接，等「连接状态」变成「已连接」'}" />

                                        <!-- 标号 5 -->
                                        <svg:SvgIcon Grid.Row="4" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '⑤把房间名和密钥发给队友，照第 3~6 步做一遍'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 下载 -->
                    <Border x:Name="SecDownload"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/download"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '下载'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页面顶部是「运行环境」卡片，可以折叠，逐条显示已安装 / 未安装，并带一个「一键补全」按钮，把缺的组网组件与 7-Zip 下载到程序目录。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 其余条目按分组自动分区，默认收起。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「更多下载」里的文件可以自选保存目录，大文件支持多线程下载。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第三方运行库（DirectX / .NET / VC++ / XNA 等）只给官网地址，不代为分发。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 黑屏补丁（cnc-ddraw）下载后会让你选一个实例，装到它的游戏目录。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页面只提供运行库与启动器补丁，不提供任何游戏资源。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页顶的「下载目录」可以更改或直接打开；大文件会分片并发下载，下完自动合并。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 下载线路与启动器更新共用（设置 → 更新线路），一个源失败会自动换另一个。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 樱花 Frp 引擎（frpc）在你用樱花方案连接时自动下载；「运行环境」卡片还能「展开组件列表」逐条查看。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页头下面是「下载目录」一行：显示当前目录，可以「更改」或「打开」。这个目录只影响「更多下载」里保存到本地的文件和插件包，不影响组件缓存。&#10;· 页面上常驻一条提示：只提供运行库和启动器补丁，不提供任何游戏资源。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「运行环境」卡的按钮会随状态变：有缺失时是「一键补全（N）」，全就绪时变成「全部重装」。&#10;· 点「展开组件列表」逐条查看：每个组件有名称、说明、已安装 / 未安装标签，以及「下载」（多分卷会标「下载（N 卷）」）和「打开链接」。&#10;· 组件都装到启动器目录的 runtime\ 下。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 其余下载项按分组折成卡片，默认收起，按钮是「展开「分组名」（N 项）」；常见分组有「组网与运行组件」「游戏补丁」「运行库（官网下载）」「插件包」「其它下载」。&#10;· 每条右边有「打开链接」和「下载」；纯官网条目没有下载按钮，点整行就用浏览器打开官网。&#10;· 这个列表来自仓库 survive 分支的 download.json，点「刷新列表」即可生效，不用等启动器发新版本。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 下载去向按条目类型走：运行组件解压到 runtime\ 下，插件包放进「包管理 → 插件」的包目录，其它存到「下载目录」。&#10;· 大文件分片并发下载、下完自动合并，多分卷按顺序合并成一个文件；不想要多线程可以在「设置 → 程序更新」里关掉。&#10;· 「游戏补丁」里的黑屏补丁（cnc-ddraw）下载后会让你选一个实例，装进它的游戏目录，并自动打开它自带的配置程序。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 窗口标题条 -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico" Width="14" Height="14" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="Hello Mental Omega Launcher" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 侧栏（跨第 1~3 行） -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Width="118"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="4">
                                            <StackPanel>
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layout-dashboard" Text="{loc:T '主页'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layers" Text="{loc:T '游戏实例'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/package" Text="{loc:T '包管理'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/network" Text="{loc:T '联机'}" />
                                                <c:NavItem GroupName="MockNav" IsChecked="True" Icon="lucide/download" Text="{loc:T '下载'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/scroll-text" Text="{loc:T '运行日志'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/settings" Text="{loc:T '设置'}" />
                                                <c:NavItem GroupName="MockNav" Margin="0,10,0,0" Icon="lucide/book-marked" Text="{loc:T '新手教程'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/info" Text="{loc:T '关于'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 页头 + 下载目录 -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Width="292"
                                                    HorizontalAlignment="Left"
                                                    Margin="128,6,0,0">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{loc:T '下载'}" />
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="D:\HMOL\Downloads"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <c:OutlineButton Content="{loc:T '更改'}" Padding="7,2" FontSize="10" />
                                                    <c:OutlineButton Content="{loc:T '打开'}" Padding="7,2" FontSize="10" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 运行环境卡 -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10">
                                            <StackPanel>
                                                <TextBlock FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{loc:T '运行环境'}" />
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="7-Zip" />
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{DynamicResource Accent.Faint}"
                                                            CornerRadius="{DynamicResource Radius.Small}"
                                                            Padding="5,1">
                                                        <TextBlock FontSize="9.5"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{loc:T '已安装'}" />
                                                    </Border>
                                                </Grid>
                                                <Grid Margin="0,5,0,0">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="n2n" />
                                                    <c:OutlineButton HorizontalAlignment="Right"
                                                                     Content="{loc:T '下载'}"
                                                                     Padding="6,1"
                                                                     FontSize="9.5" />
                                                </Grid>
                                                <c:OutlineButton Margin="0,7,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 Content="{loc:T '一键补全'}"
                                                                 Tone="Solid"
                                                                 Padding="9,3"
                                                                 FontSize="10.5" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 分组折叠 -->
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="0"
                                                    Width="292"
                                                    HorizontalAlignment="Left"
                                                    Margin="128,8,0,0">
                                            <c:OutlineButton HorizontalAlignment="Left"
                                                             Content="{loc:T '展开「游戏补丁」（3 项）'}"
                                                             Padding="9,4"
                                                             FontSize="10.5" />
                                            <c:OutlineButton Margin="0,5,0,0"
                                                             HorizontalAlignment="Left"
                                                             Content="{loc:T '展开「运行库（官网下载）」（7 项）'}"
                                                             Padding="9,4"
                                                             FontSize="10.5" />
                                        </StackPanel>

                                        <!-- 标注 1：下载目录 -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 页头下面一行是「下载目录」，可以更改或打开'}" />

                                        <!-- 标注 2：运行环境 + 一键补全 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 「运行环境」卡：逐条显示已安装 / 未安装，缺的可以「下载」，下面「一键补全」'}" />

                                        <!-- 标注 3：分组折叠 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 其余下载项按分组折叠，默认收起；展开后每条都有「打开链接」和「下载」'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 运行日志 -->
                    <Border x:Name="SecLogs"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/scroll-text"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '运行日志'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 有三个视图：内存日志、游戏日志、磁盘日志。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 可以导出 TXT / CSV、打开日志目录、清理旧日志。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 游戏启动后的输出会实时进入「游戏日志」。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 三个视图的分工：「应用日志」是启动器自己的操作记录（内存里只留最近 500 条，切走页面也不会丢），「游戏日志」是游戏进程的输出，「磁盘日志」是已经落盘的日志文件。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 磁盘日志按份数保留最近 16 份、单文件上限 8 MB；「清理旧日志」会删掉 7 天前的文件，正在写入的那份会跳过。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 导出 CSV 带 BOM，用 Excel 打开中文不乱码。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 三个页签「应用日志 / 游戏日志 / 磁盘日志」选中项是实心的；操作栏有「刷新」「清空视图」「导出 TXT」「导出 CSV」「打开日志目录」「清理旧日志」（危险色）。&#10;· 「清空视图」只清掉当前显示，不动内存里的缓冲——之后再刷新或来新日志，内容还会回来。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 切到「磁盘日志」时，上面会多出一排日志文件按钮，点一下就看那一份；按钮悬停会显示完整路径和最后写入时间，被清理掉的会自动跳到最新一份。&#10;· 应用 / 游戏日志是实时的：新内容进来会自动滚到底部；磁盘日志是静态快照，不跟着滚动。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 内存里只保留最近 500 条，切走页面甚至页面被重建都不会丢；磁盘日志单份最多显示最后 2000 行，避免大文件把界面卡住。&#10;· 「清理旧日志」会删掉 7 天前的日志文件，正在写入的那一份会跳过，删之前会先弹确认框。&#10;· 每行按级别着色：ERROR / FATAL 红、WARN 黄、其余用次要色；空视图里会给你一个「刷新」按钮引导。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 窗口标题条 -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico" Width="14" Height="14" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="Hello Mental Omega Launcher" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 侧栏（跨第 1~3 行） -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Width="118"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="4">
                                            <StackPanel>
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layout-dashboard" Text="{loc:T '主页'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layers" Text="{loc:T '游戏实例'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/package" Text="{loc:T '包管理'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/network" Text="{loc:T '联机'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/download" Text="{loc:T '下载'}" />
                                                <c:NavItem GroupName="MockNav" IsChecked="True" Icon="lucide/scroll-text" Text="{loc:T '运行日志'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/settings" Text="{loc:T '设置'}" />
                                                <c:NavItem GroupName="MockNav" Margin="0,10,0,0" Icon="lucide/book-marked" Text="{loc:T '新手教程'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/info" Text="{loc:T '关于'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 页头 + 视图页签 + 磁盘文件 -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Width="292"
                                                    HorizontalAlignment="Left"
                                                    Margin="128,6,0,0">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{loc:T '运行日志'}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <c:OutlineButton Content="{loc:T '应用日志'}" Tone="Solid" Padding="8,3" FontSize="10.5" />
                                                <c:OutlineButton Content="{loc:T '游戏日志'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                                <c:OutlineButton Content="{loc:T '磁盘日志'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <c:OutlineButton Content="2026-10-11.log" Tone="Solid" Padding="6,2" FontSize="9.5" />
                                                <c:OutlineButton Content="2026-10-10.log" Padding="6,2" FontSize="9.5" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 等宽日志区 -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Height="60"
                                                Margin="128,8,0,0"
                                                HorizontalAlignment="Left"
                                                Width="292"
                                                Background="{DynamicResource Surface.Sunken}"
                                                BorderBrush="{DynamicResource Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8">
                                            <StackPanel>
                                                <TextBlock FontSize="10.5"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="[INFO] Hello Mental Omega Launcher started" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10.5"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="[INFO] Page self-check: ok" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10.5"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="[INFO] Game process started" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 操作按钮 -->
                                        <WrapPanel Grid.Row="3"
                                                   Grid.Column="0"
                                                   Width="292"
                                                   HorizontalAlignment="Left"
                                                   Margin="128,8,0,0">
                                            <c:OutlineButton Content="{loc:T '刷新'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '清空视图'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '导出 TXT'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '导出 CSV'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '打开日志目录'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '清理旧日志'}" Tone="Danger" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                        </WrapPanel>

                                        <!-- 标注 1：页签 + 磁盘文件 -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 三个页签：应用日志 / 游戏日志 / 磁盘日志；切到磁盘日志，上面会多出一排日志文件按钮'}" />

                                        <!-- 标注 2：日志区 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 应用 / 游戏日志实时滚到底（内存留最近 500 条）；磁盘日志最多显示单份最后 2000 行'}" />

                                        <!-- 标注 3：操作按钮 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 刷新 / 清空视图 / 导出 TXT、CSV / 打开日志目录 / 清理旧日志'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 设置 -->
                    <Border x:Name="SecSettings"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/settings"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '设置'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 左边是两级：先选一个大类（个性化 / 更新与下载 / 联机 / 其他 / 语言），点进去再选该大类下的具体分类。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 所有改动都立即生效并自动保存，不用点「应用」；配置文件是数据目录里的 Settings.json。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 停在分组列表这一层时，右边是「设置主页」：一段说明、几条小贴士和「常用入口」快捷按钮，点按钮直接跳到对应分类。'}" />

                                <TextBlock Margin="0,16,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}"
                                           Text="{loc:T '个性化'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '外观'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 明暗模式：浅色 / 深色 / 跟随系统。&#10;· 强调色：默认 / 湖蓝 / 青绿 / 紫罗兰 四个预设。&#10;· 自定义强调色：拖「色相 / 饱和度 / 明度」滑块，或直接填 #RRGGBB 再点「应用」；「从背景图取色」抓当前壁纸的主色，「用预设色」退回预设。&#10;· 色板预览：当前主色系的深 / 基 / 亮 / 悬停 / 柔 / 淡六级色。&#10;· 界面字体：从系统已装字体里挑一个，下面有预览行。&#10;· 卡片圆角：统一放大 / 缩小所有卡片的圆角。&#10;· 界面动效：总开关 + 速度（0.5×~2×），关掉后所有过渡直接落到终态。&#10;· 窗口透明度：整个窗口（含文字）一起变透，最低 50%。&#10;· 界面缩放：等比放大 / 缩小整个界面。&#10;· 卡片透明度：只让卡片、侧栏、标题栏这些承载面变透，文字图标保持清晰，最低 30%。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '主页设置'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 显示模式：默认模式（完整主页）/ 简洁模式（像 HMCL，只留右下角一个「启动游戏」，其余留空露出背景）。&#10;· 附加小组件：时钟 / 便签 / 音乐控制，打开后出现在主页，可在布局编辑器里拖动、缩放、隐藏。&#10;· 时钟：24 / 12 小时制切换、是否在下面显示日期。&#10;· 便签：填标题与正文（多行），内容会显示在主页的便签卡上。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '主页背景'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 选择图片 / 动图 / 视频：支持静态图、GIF 动图、视频。&#10;· 导入壁纸包：直接导入 Wallpaper Engine 导出的 .pkg / .mpkg，自动解包取里面的视频或图片。&#10;· 清除背景：回到主题渐变。&#10;· 模糊程度 / 暗化程度：给背景加模糊与压暗，让前景更清楚（视频只压暗、不模糊）。&#10;· 轮播清单：导入过的素材都列在这里，可以「使用」或「移除」。&#10;· 轮播间隔 + 开关 + 顺序 / 随机：到点自动换背景。&#10;· 填充方式：铺满 / 适应 / 拉伸 / 平铺（平铺只对静态图有效）。&#10;· 鼠标视差：背景随光标轻微位移。&#10;· 每页独立背景：给某个页面单独指定背景，选「跟随全局」就用上面的当前背景。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '背景音乐'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 启用背景音乐：开启后随程序启动自动播放播放列表（自启方式启动时先驻留托盘，打开主窗口后再播）。&#10;· 上一首 / 播放暂停 / 下一首，以及音量滑块。&#10;· 循环、随机两个开关。&#10;· 播放列表：添加曲目 / 移除当前曲目 / 单曲移除。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '界面布局'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 打开布局编辑器：拖动主页各区块、调整左侧导航的顺序 / 显隐 / 名称，方案能导出 / 导入 JSON，点「保存并应用」后立即生效。&#10;· 恢复默认布局：一键回到出厂布局。&#10;· 主页小组件显隐：日历 / 天气 / 常用网站，关掉的会从主页拿掉，内容仍保留在设置里。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '常用网站'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 主页「常用网站」小组件里显示的站点，点击用系统默认浏览器打开。&#10;· 填「名称 + 网址（http / https）」再点「添加」；列表里每行都能单独移除。&#10;· 「恢复默认列表」把默认站点加回来。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '天气城市'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 填城市名（如「北京」「上海」）后点「保存城市」，主页天气小组件就显示它。&#10;· 「验证城市」可以马上确认这个名字能不能解析到天气数据。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '扩展模块'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 扩展是一份 JSON 清单，用来在主页加一张小组件卡片：标题、图标、文字行、可选的数据源与点击网址。&#10;· 安全说明：扩展不会被「执行」—— 启动器不加载任何程序集、不引入脚本引擎，只把清单里的文字画到卡片上；数据源仅做只读 GET，有超时与缓存；用「数据源联网总开关」可以整个关掉联网。&#10;· 扩展目录：每个 .json 文件就是一个扩展，可「新建扩展」（表单填写）/「重新加载」/「打开扩展目录」。&#10;· 每个扩展条目右侧三个按钮：编辑清单、启用 / 停用、删除。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '窗口与音效'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 点右上角 × 时：每次询问 / 最小化到托盘 / 直接退出（默认每次询问）。&#10;· 窗口标题文字：留空用默认名；标题栏与任务栏都会跟着改。&#10;· 窗口图标：选一张图当图标，或「用内置图标」。&#10;· 启动音效 / 关闭音效：各选一个音频文件，启动 / 退出时播放（关闭音效会在退出前留约 0.7 秒）。&#10;· 图标与音效都会复制进数据目录的 custom 子目录，原文件删掉也不影响。'}" />

                                <TextBlock Margin="0,16,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}"
                                           Text="{loc:T '更新与下载'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '程序更新'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 启动时自动检查更新：每次启动在后台查一次新版本，失败只写日志、不打扰。&#10;· 更新线路：自动 / GitHub 优先 / Gitee 优先；无论选哪个，取不到都会自动换另一个源。&#10;· 下载加速（多线程）：大文件分段并发下载，个别网络下可关掉退回单连接。&#10;· 「检查启动器更新」按钮：手动查一次并一键更新；更新只替换启动器本身，设置、实例与游戏文件都不动。'}" />

                                <TextBlock Margin="0,16,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}"
                                           Text="{loc:T '联机'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '联机设置'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 联机昵称：与 CnCNet 客户端共用同一个玩家名，填完点「保存昵称」。&#10;· 游戏内 HUD：点「打开游戏 HUD」开关游戏里的置顶小浮窗（显示本房间的对端与延迟）。&#10;· HUD 透明度：只影响那个浮窗（含文字与底色），最低 40%。&#10;· 樱花FRP 内嵌面板：把樱花 Frp 的管理页嵌进启动器，需要本机的 WebView2 运行时。'}" />

                                <TextBlock Margin="0,16,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}"
                                           Text="{loc:T '其他'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '开机自启'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 登录系统后自动启动：自启后只驻留系统托盘、不弹主窗口；点托盘图标或托盘菜单里的「显示主窗口」才打开界面。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           Text="{loc:T '游戏路径'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
