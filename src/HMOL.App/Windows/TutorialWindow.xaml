<Window xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Windows.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        xmlns:svg="clr-namespace:HMOL.App.Controls.Svg"
        Title="{loc:T '新手教程'}"
        Width="1020"
        Height="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 全部教程正文装在这一张卡片里，正文超出窗口高度时在卡片内滚动 -->
        <c:SurfaceCard x:Name="CardTutorial"
                       Grid.Row="0"
                       Title="{loc:T '新手教程'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧分类侧栏：点哪一项，右侧只显示对应小节 -->
                <Border Grid.Column="0"
                        Width="190"
                        Background="{DynamicResource Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Padding="6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Margin="6,4,0,4"
                                   Text="{loc:T '基础'}" />
                        <c:NavItem x:Name="NavHowToUse"
                                   GroupName="GuideNav"
                                   Icon="lucide/circle-help"
                                   Text="{loc:T '怎么用这份教程'}"
                                   Tag="SecHowToUse"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/rocket"
                                   Text="{loc:T '三步上手'}"
                                   Tag="SecQuickStart"
                                   Checked="OnSectionChecked" />

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Margin="6,10,0,4"
                                   Text="{loc:T '各页面'}" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/layout-dashboard"
                                   Text="{loc:T '主页'}"
                                   Tag="SecHome"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/layers"
                                   Text="{loc:T '游戏实例'}"
                                   Tag="SecInstances"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/copy"
                                   Text="{loc:T '一个文件夹里的两个版本'}"
                                   Tag="SecShared"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/package"
                                   Text="{loc:T '包管理'}"
                                   Tag="SecPackages"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/network"
                                   Text="{loc:T '联机'}"
                                   Tag="SecMultiplayer"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/download"
                                   Text="{loc:T '下载'}"
                                   Tag="SecDownload"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/scroll-text"
                                   Text="{loc:T '运行日志'}"
                                   Tag="SecLogs"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/settings"
                                   Text="{loc:T '设置'}"
                                   Tag="SecSettings"
                                   Checked="OnSectionChecked" />

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Margin="6,10,0,4"
                                   Text="{loc:T '更多窗口'}" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/monitor-cog"
                                   Text="{loc:T '配置向导'}"
                                   Tag="SecWizard"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/circle-plus"
                                   Text="{loc:T '新建实例'}"
                                   Tag="SecEditor"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/layout-list"
                                   Text="{loc:T '界面布局'}"
                                   Tag="SecLayout"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/puzzle"
                                   Text="{loc:T '扩展模块'}"
                                   Tag="SecExtension"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/wrench"
                                   Text="{loc:T '联机工具与浮窗'}"
                                   Tag="SecMpTools"
                                   Checked="OnSectionChecked" />

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Margin="6,10,0,4"
                                   Text="{loc:T '其他'}" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/info"
                                   Text="{loc:T '关于与这份教程'}"
                                   Tag="SecAbout"
                                   Checked="OnSectionChecked" />
                        <c:NavItem GroupName="GuideNav"
                                   Icon="lucide/sparkles"
                                   Text="{loc:T '几句话记住'}"
                                   Tag="SecSummary"
                                   Checked="OnSectionChecked" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ScrollSections"
                              Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanSections">

                    <!-- 怎么用这份教程 -->
                    <Border x:Name="SecHowToUse"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/circle-help"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '怎么用这份教程'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 这是 HMOL 的内置新手教程，用来告诉你每个页面、每个按钮是干什么的。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 随时可以从左下角的「新手教程」再打开它。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 它只在第一次运行程序时提示一次。'}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 三步上手 -->
                    <Border x:Name="SecQuickStart"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/rocket"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '三步上手'}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26"
                                            Height="26"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Accent.Base}"
                                            CornerRadius="13">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.OnAccent}"
                                                   Text="1" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:T '· 第一步：先告诉启动器游戏装在哪 —— 打开「设置 → 游戏路径 → 重新运行配置向导」，或直接在「游戏实例」页新建一个实例。'}" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26"
                                            Height="26"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Accent.Base}"
                                            CornerRadius="13">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.OnAccent}"
                                                   Text="2" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:T '· 第二步：在「游戏实例」页新建一个实例（一个游戏目录对应一个实例）。'}" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26"
                                            Height="26"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Accent.Base}"
                                            CornerRadius="13">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.OnAccent}"
                                                   Text="3" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:T '· 第三步：回到「主页」，点「启动游戏」。'}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 主页 -->
                    <Border x:Name="SecHome"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/layout-dashboard"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '主页'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 中间是「启动游戏」按钮；游戏运行中，它会变成结束游戏的按钮。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 下面依次是「当前实例」卡和「切换实例」卡：前者显示启动按钮与实例信息，后者点一行就能换实例。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 再往下是小组件：月历、现实天气、常用网站，以及可选的时钟、便签、音乐控制。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 天气的城市在「设置 → 天气城市」里设置，常用网站可以自己自定义。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 整页各个区块的位置，可以在「设置 → 界面布局」的布局编辑器里拖动、缩放、隐藏。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 当前实例卡上会显示实例名、游戏目录、状态（就绪 / 运行中 / 目录不可用）、上次启动时间与备注。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 游戏运行中时「启动游戏」按钮会变成「停止游戏」，点它可以结束游戏进程。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 天气数据来自 Open-Meteo（免费、无需 Key），30 分钟内复用缓存，点天气卡右上角可以强制刷新。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 顶部欢迎横幅：按时间问候（早上好 / 下午好 / 晚上好 / 夜深了）、当前版本号，以及一句话状态（没有实例 / 运行中 / 已就绪 / 目录不可用）。&#10;· 横幅下面的大按钮就是「启动游戏」；游戏运行中它会变成「停止游戏」，点一下结束游戏进程。&#10;· 一个实例都没有时，中间是一张引导卡，点「去创建实例」直接跳到「游戏实例」页。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 当前实例卡：按钮下面依次是实例名、状态胶囊（运行中 / 就绪 / 目录不可用）、游戏目录（悬停看完整路径）、简介、备注、上次启动时间。&#10;· 目录不可用或正在启动时，「启动游戏」会禁用；运行中则变成「停止游戏」。&#10;· 卡上还会按情况给提醒：游戏运行中建议先关游戏再改插件包；目录有效但找不到主程序时提醒核对游戏文件。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 切换实例卡：列出所有实例（图标 + 名称 + 目录），当前实例带勾选高亮；点任意一行就切换过去，不必回「游戏实例」页。&#10;· 只有一个实例时这里会提示去「游戏实例」页再建一个。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 天气卡右上角有「刷新天气」按钮（平时 30 分钟内走缓存）；没设城市、没有网站时，卡上会直接给「去设置」入口。&#10;· 常用网站点击用系统默认浏览器打开，网址不合法会弹窗提示去「设置 → 常用网站」改。&#10;· 天气城市在「设置 → 天气城市」设置，网站清单在「设置 → 常用网站」维护。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 时钟 / 便签 / 音乐控制在「设置 → 主页设置」里开关；音乐控制卡能上一首 / 播放暂停 / 下一首。&#10;· 装了的声明式扩展也会在主页加一张卡（标题、图标、文字行），带数据源的会按清单间隔自动刷新。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页面底部有一条提示：启动前确认插件包已装好，游戏输出会记到「运行日志 → 游戏日志」。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「简洁模式」（设置 → 主页设置）下整页只剩右下角一个启动按钮，旁边的小箭头向上弹出切换实例；没有实例时按钮变成「创建实例」。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 窗口标题条 -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico" Width="14" Height="14" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="Hello Mental Omega Launcher" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 完整侧栏（跨第 1~5 行） -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="5"
                                                Grid.Column="0"
                                                Width="118"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="4">
                                            <StackPanel>
                                                <c:NavItem GroupName="MockNav" IsChecked="True" Icon="lucide/layout-dashboard" Text="{loc:T '主页'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layers" Text="{loc:T '游戏实例'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/package" Text="{loc:T '包管理'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/network" Text="{loc:T '联机'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/download" Text="{loc:T '下载'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/scroll-text" Text="{loc:T '运行日志'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/settings" Text="{loc:T '设置'}" />
                                                <c:NavItem GroupName="MockNav" Margin="0,10,0,0" Icon="lucide/book-marked" Text="{loc:T '新手教程'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/info" Text="{loc:T '关于'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 欢迎横幅 -->
                                        <Border Grid.Row="1"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,6,0,0"
                                                Background="{DynamicResource Accent.Faint}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10,8">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{loc:T '晚上好'}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{loc:T '当前实例「3.3.6」已就绪，游戏目录可用。'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 当前实例卡片 -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{loc:T '当前实例'}" />
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{DynamicResource Accent.Faint}"
                                                            CornerRadius="{DynamicResource Radius.Small}"
                                                            Padding="6,2">
                                                        <TextBlock FontSize="10.5"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{loc:T '就绪'}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="3.3.6" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="D:\Games\MentalOmega" />
                                                <c:OutlineButton Margin="0,8,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 Content="{loc:T '启动游戏'}"
                                                                 Tone="Solid"
                                                                 Padding="12,5"
                                                                 FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 切换实例卡片 -->
                                        <Border Grid.Row="3"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10">
                                            <StackPanel>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '切换实例'}" />
                                                <Grid Margin="0,6,0,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <svg:SvgIcon Width="12" Height="12" Icon="lucide/layers" IconBrush="{DynamicResource Text.Tertiary}" />
                                                        <TextBlock Margin="6,0,0,0"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="3.3.6" />
                                                    </StackPanel>
                                                    <svg:SvgIcon HorizontalAlignment="Right"
                                                                 Width="12"
                                                                 Height="12"
                                                                 Icon="lucide/circle-check"
                                                                 IconBrush="{DynamicResource Accent.Base}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 小组件 -->
                                        <StackPanel Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="128,8,0,0"
                                                    Orientation="Horizontal">
                                            <Border Width="92"
                                                    Height="40"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '日历'}" />
                                            </Border>
                                            <Border Width="92"
                                                    Height="40"
                                                    Margin="8,0,0,0"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '天气'}" />
                                            </Border>
                                            <Border Width="92"
                                                    Height="40"
                                                    Margin="8,0,0,0"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{DynamicResource Radius.Small}">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '常用网站'}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 底部提示条 -->
                                        <Border Grid.Row="5"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <TextBlock FontSize="10.5"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       TextWrapping="Wrap"
                                                       Text="{loc:T '启动前请确认已安装所需的插件包；游戏输出见「运行日志 → 游戏日志」。'}" />
                                        </Border>

                                        <!-- 标注 1：欢迎横幅 -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 顶部是欢迎横幅：问候语、版本号与状态一句话'}" />

                                        <!-- 标注 2：当前实例 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 当前实例卡：启动 / 停止按钮，下面是实例名、状态、目录、备注、上次启动'}" />

                                        <!-- 标注 3：切换实例 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 切换实例卡：点一行就换成当前实例'}" />

                                        <!-- 标注 4：小组件 -->
                                        <svg:SvgIcon Grid.Row="4" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 小组件：月历、天气、常用网站，以及可选的时钟 / 便签 / 音乐'}" />

                                        <!-- 标注 5：底部提示 + 侧栏 -->
                                        <svg:SvgIcon Grid.Row="5" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="5" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 底部是启动提示；左边侧栏切换页面，左下角是「新手教程」和「关于」'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 游戏实例 -->
                    <Border x:Name="SecInstances"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/layers"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '游戏实例'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 可以新建、编辑、删除、重命名实例。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 游戏类型（心灵终结 / 原版红警 2 / 尤里的复仇 / 其它红警 Mod）决定卡片的图标与默认主程序。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 主程序可以手动指定；给游戏挂非 MO 的 Mod 时会用到。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「设为当前实例」决定主页「启动游戏」启动哪一个实例。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「打开目录」直接打开该实例的游戏目录，界面上也会显示它占用的体积。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 实例可以导出、导入。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页面底部是备份区：创建备份、备份原版游戏、还原到当前实例、删除备份、刷新列表；强烈建议在装任何包之前先做一次原版备份。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 卡片上能看到实例名称、游戏目录、状态（就绪 / 就绪（N 个版本）/ 游戏目录不可用）、备注与占用体积。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 备份区分三类：「备份原版游戏」把当前实例存成原版（固定放在 backup\MO，名称不可改）；「创建备份」是你的用户备份（名称可自定）；「还原到当前实例」用选中的备份覆盖回实例。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 还原是整体替换、不可撤销：会用选中的备份覆盖当前实例的游戏目录；如果这个实例的安装记录就在游戏目录里，还原后会被清除。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页头有三个按钮：「新建实例」「导入实例」「刷新」；下面的「当前实例：…」条告诉你现在操作的是哪个实例。&#10;· 每张实例卡显示：图标（取自实例主程序）、名称、状态（或「就绪（N 个版本）」）、游戏目录、备注、占用体积（后台计算，目录不存在会标出来）。&#10;· 目录失效时卡片图标会变成红色警告，一眼就能看出这个实例当前不可用。&#10;· 一台机器同一时刻只能跑一个游戏，重复启动会提示先关掉正在运行的。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 卡片上的一排按钮：「启动游戏」「设为当前」（已是当前实例时会变成实心的「正在使用」）「打开目录」（打开实例数据目录）「编辑」「重命名」「导出」「删除」。&#10;· 「编辑」可以改名称、游戏目录、游戏类型、主程序、备注，也能配「多版本」。&#10;· 「导出」把实例打包成 zip / 7z 实例包，可选「快速」或「最小」压缩级别。&#10;· 导入的实例，游戏文件会落在实例数据目录里，所以删除它时会连游戏文件一起删（删除确认框里会明确警告）。&#10;· 导入完成后，导入的实例会自动被设为当前实例。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 备份区是「备份与还原」，备份对象永远是当前实例：&#10;· 「创建备份」是你的用户备份，名称可自定（不能用 MO / 原版 等保留名），默认名带时间戳。&#10;· 「备份原版游戏」把当前实例存成原版备份，固定放在 backup\MO、名称不可改——请确认这个实例现在确实是原版状态。&#10;· 「还原到当前实例」把选中的备份整体覆盖回实例，会先选中一条备份才能点。&#10;· 「删除备份」删掉选中的那条；删除过程不可中断（没有取消按钮）。删掉原版备份后，「选择性卸载」和「全量恢复原版」都不能用，必须重新做一次「备份原版游戏」。&#10;· 备份行上会显示文件数、体积、创建时间与来源实例。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 还没有任何实例时，页面中间是一张引导卡：「实例只记录游戏装在哪，不会复制游戏本体」，点「新建实例」开始。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 窗口标题条 -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico" Width="14" Height="14" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="Hello Mental Omega Launcher" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 侧栏（跨第 1~3 行） -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Width="118"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="4">
                                            <StackPanel>
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layout-dashboard" Text="{loc:T '主页'}" />
                                                <c:NavItem GroupName="MockNav" IsChecked="True" Icon="lucide/layers" Text="{loc:T '游戏实例'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/package" Text="{loc:T '包管理'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/network" Text="{loc:T '联机'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/download" Text="{loc:T '下载'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/scroll-text" Text="{loc:T '运行日志'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/settings" Text="{loc:T '设置'}" />
                                                <c:NavItem GroupName="MockNav" Margin="0,10,0,0" Icon="lucide/book-marked" Text="{loc:T '新手教程'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/info" Text="{loc:T '关于'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 页头：标题 + 三个按钮 -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Width="292"
                                                    HorizontalAlignment="Left"
                                                    Margin="128,6,0,0">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{loc:T '游戏实例'}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <c:OutlineButton Content="{loc:T '新建实例'}" Tone="Solid" Padding="8,3" FontSize="10.5" />
                                                <c:OutlineButton Content="{loc:T '导入实例'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                                <c:OutlineButton Content="{loc:T '刷新'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 实例卡 -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <svg:SvgIcon Width="14" Height="14" Icon="lucide/layers" IconBrush="{DynamicResource Accent.Base}" />
                                                        <TextBlock Margin="6,0,0,0"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="3.3.6" />
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right"
                                                            Background="{DynamicResource Accent.Faint}"
                                                            CornerRadius="{DynamicResource Radius.Small}"
                                                            Padding="6,2">
                                                        <TextBlock FontSize="10.5"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{loc:T '当前实例'}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="D:\Games\MentalOmega" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '占用体积：12.4 GB'}" />
                                                <WrapPanel Margin="0,7,0,0">
                                                    <c:OutlineButton Content="{loc:T '启动游戏'}" Tone="Solid" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '设为当前'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '打开目录'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '编辑'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '重命名'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '导出'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '删除'}" Tone="Danger" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 备份与还原卡 -->
                                        <Border Grid.Row="3"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10">
                                            <StackPanel>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{loc:T '备份与还原'}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '备份对象 = 当前实例「3.3.6」'}" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <c:OutlineButton Content="{loc:T '创建备份'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '备份原版游戏'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '还原到当前实例'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '删除备份'}" Tone="Danger" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                    <c:OutlineButton Content="{loc:T '刷新列表'}" Padding="8,3" FontSize="10.5" Margin="0,0,5,5" />
                                                </WrapPanel>
                                                <Border Margin="0,2,0,0"
                                                        Background="{DynamicResource Surface.Card}"
                                                        CornerRadius="{DynamicResource Radius.Small}"
                                                        Padding="8,5">
                                                    <Grid>
                                                        <TextBlock FontSize="10.5"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="{loc:T '原版游戏（MO）'}" />
                                                        <Border HorizontalAlignment="Right"
                                                                Background="{DynamicResource Accent.Faint}"
                                                                CornerRadius="{DynamicResource Radius.Small}"
                                                                Padding="5,1">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource Text.Secondary}"
                                                                       Text="{loc:T '原版游戏'}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- 标注 1：页头 -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 页头三按钮：新建实例 / 导入实例 / 刷新'}" />

                                        <!-- 标注 2：实例卡 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 实例卡：名称 / 状态 / 目录 / 备注 / 体积，外加整排操作按钮（启动、设为当前、打开目录、编辑、重命名、导出、删除）'}" />

                                        <!-- 标注 3：备份区 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 备份区：对象永远是当前实例，创建 / 原版备份 / 还原 / 删除 / 刷新列表'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 一个文件夹里的两个版本 -->
                    <Border x:Name="SecShared"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/copy"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '一个文件夹里的两个版本'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 同一个游戏目录可以配多个版本：一个版本就是一个可执行文件。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 在「游戏实例」里编辑这个实例，点「多版本…」，一次选中 2 个 exe，再分别起名（比如 3.3.6 和 3.3.5）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 名字会出现在启动时弹出的选择框里；不想用多版本了就点「回到单版本」。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 之后点「启动游戏」，会先弹一个框让你选这次启动哪个版本。'}" />

                                <Border Margin="0,6,0,0"
                                        Background="{DynamicResource Status.WarnSoft}"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        Padding="10,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgIcon Width="12"
                                                         Height="12"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/triangle-alert"
                                                         IconBrush="{DynamicResource Status.Warn}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Warn}"
                                                       Text="{loc:T '注意'}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Text="{loc:T '· 包管理与备份都是针对整个游戏目录的，所以同一个实例里的这些版本共用同一份包记录与备份。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 多版本和「同文件夹多实例」是两件事：多版本是「一个实例里配多个 exe」，启动时选一个；「同文件夹多实例」是「同一个目录给两个实例共用」，一般只在两套包组合要共用同一目录时才需要。只是想加同一个文件夹里的另一个版本，用「添加版本」更直接。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 点「多版本…」后单版本输入框会收起，出现「游戏版本（可选）」列表：点「添加版本…」一次可多选 exe，每行左边填版本名、右边是它的 exe。&#10;· 目录里还有没加进来的 exe 时会多一个「加入目录里的主程序」按钮，一键全加进来；点「回到单版本」就切回单个主程序输入框（多版本列表会保留，随时能再切回来）。'}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 实例编辑器卡片底（跨第 0~1 行） -->
                                        <Border Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Card}"
                                                BorderBrush="{DynamicResource Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Card}" />

                                        <!-- 游戏主程序（可选） -->
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="10,10,10,0"
                                                    VerticalAlignment="Top">
                                            <TextBlock FontSize="11.5"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Text="{loc:T '游戏主程序（可选）'}" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Height="28"
                                                        Background="{DynamicResource Surface.Sunken}"
                                                        BorderBrush="{DynamicResource Border.Default}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.Button}"
                                                        Padding="8,0">
                                                    <TextBlock HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="MentalOmega.exe" />
                                                </Border>
                                                <c:OutlineButton Grid.Column="1"
                                                                 Margin="8,0,0,0"
                                                                 Content="{loc:T '浏览…'}"
                                                                 Padding="8,3"
                                                                 FontSize="11" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- 多版本… 按钮 -->
                                        <c:OutlineButton Grid.Row="1"
                                                         Grid.Column="0"
                                                         Margin="10,6,10,10"
                                                         HorizontalAlignment="Left"
                                                         Content="{loc:T '多版本…'}"
                                                         Padding="10,4"
                                                         FontSize="11.5" />

                                        <!-- 多版本列表 -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Width="420"
                                                Margin="0,10,0,0"
                                                Background="{DynamicResource Surface.Card}"
                                                BorderBrush="{DynamicResource Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Card}"
                                                Padding="10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Height="26"
                                                            Background="{DynamicResource Surface.Sunken}"
                                                            BorderBrush="{DynamicResource Border.Default}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius.Button}"
                                                            Padding="8,0">
                                                        <TextBlock HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                                   Text="3.3.6" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="MentalOmega336.exe" />
                                                    <svg:SvgIcon Grid.Column="2"
                                                                 Margin="8,0,0,0"
                                                                 Width="12"
                                                                 Height="12"
                                                                 VerticalAlignment="Center"
                                                                 Icon="lucide/x"
                                                                 IconBrush="{DynamicResource Text.Tertiary}" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Height="26"
                                                            Background="{DynamicResource Surface.Sunken}"
                                                            BorderBrush="{DynamicResource Border.Default}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius.Button}"
                                                            Padding="8,0">
                                                        <TextBlock HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                                   Text="3.3.5" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="MentalOmega335.exe" />
                                                    <svg:SvgIcon Grid.Column="2"
                                                                 Margin="8,0,0,0"
                                                                 Width="12"
                                                                 Height="12"
                                                                 VerticalAlignment="Center"
                                                                 Icon="lucide/x"
                                                                 IconBrush="{DynamicResource Text.Tertiary}" />
                                                </Grid>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <c:OutlineButton Content="{loc:T '添加版本…'}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" />
                                                    <c:OutlineButton Content="{loc:T '回到单版本'}" Padding="10,4" FontSize="11.5" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 启动时选版本的弹框 -->
                                        <Border Grid.Row="3"
                                                Grid.Column="0"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource Surface.Card}"
                                                BorderBrush="{DynamicResource Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Card}"
                                                Padding="10">
                                            <StackPanel Width="260">
                                                <TextBlock FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{loc:T '选择要启动的版本'}" />
                                                <c:OutlineButton Content="3.3.6"
                                                                 Tone="Solid"
                                                                 Padding="10,5"
                                                                 FontSize="12"
                                                                 HorizontalAlignment="Stretch"
                                                                 Margin="0,8,0,0" />
                                                <c:OutlineButton Content="3.3.5"
                                                                 Tone="Outline"
                                                                 Padding="10,5"
                                                                 FontSize="12"
                                                                 HorizontalAlignment="Stretch"
                                                                 Margin="0,6,0,0" />
                                                <c:OutlineButton Content="{loc:T '取消'}"
                                                                 Tone="Outline"
                                                                 Padding="10,5"
                                                                 FontSize="12"
                                                                 HorizontalAlignment="Right"
                                                                 Margin="0,6,0,0" />
                                                <TextBlock Margin="0,8,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{loc:T '同文件夹多实例'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 标注 1：默认单版本 -->
                                        <svg:SvgIcon Grid.Row="0" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 默认只有一个主程序输入框'}" />

                                        <!-- 标注 2：多版本… -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 点「多版本…」可以一次选中 2 个 exe（也能点「添加版本…」逐个加；目录里还有没加的 exe 会出现「加入目录里的主程序」，「回到单版本」可切回）'}" />

                                        <!-- 标注 3：版本列表 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 每行左边填版本名、右边是它的 exe，点「启动游戏」时按名字选'}" />

                                        <!-- 标注 4：启动时选版本弹框 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 配了两个以上版本后，点「启动游戏」会先弹出这个框'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 包管理 -->
                    <Border x:Name="SecPackages"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/package"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '包管理'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 资源包分四类：INI、地图、任务、插件。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页面上半是可用包列表，下半是已安装列表。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「导入包」把压缩包放进当前分类。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「安装」时，如果目标已有同名文件，会让你选「覆盖全部」或「跳过已有」；覆盖前会自动留一份 .bak-&lt;时间戳>，失败会自动回滚。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 卸载有四种方式：「选择性卸载」（只删这个包装进去的文件，被它覆盖的原版从 MO 原版备份还原）、「按文件删除…」（从安装记录里逐个勾选要删的文件）、「回到某个时间点…」（用历次安装留下的 .bak 备份回退）、「全量恢复原版」（清空游戏目录再用原版备份整体覆盖）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 四类包各自放什么：INI 是规则与数值类改动，地图是单个 .map，任务是任务文件，插件是语音 / 美化 / 音乐等杂项。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「按文件删除」和「回到某个时间点」都是不可撤销操作，会先二次确认；「回到某个时间点」会把该时间点对应的包视为已撤销（它新建的文件被删掉，并从「已安装」列表移除）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 页头有「导入包」「打开包目录」「刷新」三个按钮；下面四个分类按钮是「INI 包 / 地图包 / 任务包 / 插件包」，切换分类就切换在看的包。&#10;· 分类下方标出这一类的「包目录」「允许的扩展名」和一条内容规范提示。&#10;· 顶部「当前实例：…」条告诉你安装 / 卸载会作用到哪个实例；没有实例时会提示先创建，旁边「管理实例」直接跳到「游戏实例」页。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 左边「可用包」：每行是包名 +（文件夹 / 压缩包 / 文件 · 体积），已装过的带绿色「已安装」徽标；行内两个按钮是「安装」「移除」。&#10;· 「移除」只删包目录里的源文件，不会动已经装进游戏目录的内容，也不等于卸载——之后就不能再用它安装 / 卸载了。&#10;· 点「安装」先弹确认框（列出装到哪个实例、哪个目录，并附「风险自担 / MO 官方不提供支持」的声明）；同名文件冲突时会让你选「覆盖全部」「跳过已有」或「取消」。&#10;· 覆盖前原文件会先存成 .bak-&lt;时间戳>，安装失败会自动回滚。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 右边「当前实例已安装」按「安装记录」显示，不是扫游戏目录：能找回源文件的会标出「来源：…」，找不到的会提示「包目录里已找不到源文件，仍可按记录卸载」。&#10;· 分类下没有可用包、或实例还没装这一类的包时，列表里都会给出下一步提示（去导入，或去左边点「安装」）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 单个 .map 的地图直接从 Maps\Custom 删除，不需要原版备份；而「按包卸载」与「全量恢复」都必须先在实例页做过「备份原版游戏」。'}" />

                                <Border Margin="0,6,0,0"
                                        Background="{DynamicResource Status.WarnSoft}"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        Padding="10,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgIcon Width="12"
                                                         Height="12"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/triangle-alert"
                                                         IconBrush="{DynamicResource Status.Warn}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Warn}"
                                                       Text="{loc:T '注意'}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Text="{loc:T '· 右下角的「内容规范」提示要知道：插件包不要包含受版权保护的音乐；INI 包请只放增量内容，不要打包整份 rulesmo.ini / artmo.ini；地图、任务包不要打包 MO 官方作品。'}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="Wrap"
                                                   Text="{loc:T '· 安装第三方包属于对游戏副本的自行改动，风险自担，MO 官方不提供支持。'}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 窗口标题条 -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico" Width="14" Height="14" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="Hello Mental Omega Launcher" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 侧栏（跨第 1~4 行） -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="4"
                                                Grid.Column="0"
                                                Width="118"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="4">
                                            <StackPanel>
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layout-dashboard" Text="{loc:T '主页'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/layers" Text="{loc:T '游戏实例'}" />
                                                <c:NavItem GroupName="MockNav" IsChecked="True" Icon="lucide/package" Text="{loc:T '包管理'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/network" Text="{loc:T '联机'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/download" Text="{loc:T '下载'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/scroll-text" Text="{loc:T '运行日志'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/settings" Text="{loc:T '设置'}" />
                                                <c:NavItem GroupName="MockNav" Margin="0,10,0,0" Icon="lucide/book-marked" Text="{loc:T '新手教程'}" />
                                                <c:NavItem GroupName="MockNav" Icon="lucide/info" Text="{loc:T '关于'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 页头 -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Width="292"
                                                    HorizontalAlignment="Left"
                                                    Margin="128,6,0,0">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{loc:T '包管理'}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <c:OutlineButton Content="{loc:T '导入包'}" Tone="Solid" Padding="8,3" FontSize="10.5" />
                                                <c:OutlineButton Content="{loc:T '打开包目录'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                                <c:OutlineButton Content="{loc:T '刷新'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 当前实例条 -->
                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Width="292"
                                                HorizontalAlignment="Left"
                                                Margin="128,8,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{loc:T '当前实例：3.3.6'}" />
                                                <c:OutlineButton HorizontalAlignment="Right"
                                                                 Content="{loc:T '管理实例'}"
                                                                 Padding="7,2"
                                                                 FontSize="10" />
                                            </Grid>
                                        </Border>

                                        <!-- 四个分类 -->
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="128,8,0,0"
                                                    Orientation="Horizontal">
                                            <c:OutlineButton Content="{loc:T 'INI 包'}" Tone="Solid" Padding="8,3" FontSize="10.5" />
                                            <c:OutlineButton Content="{loc:T '地图包'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                            <c:OutlineButton Content="{loc:T '任务包'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                            <c:OutlineButton Content="{loc:T '插件包'}" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                        </StackPanel>

                                        <!-- 可用包 / 已安装 -->
                                        <Grid Grid.Row="4"
                                              Grid.Column="0"
                                              Width="292"
                                              HorizontalAlignment="Left"
                                              Margin="128,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{DynamicResource Radius.Small}"
                                                    Padding="8">
                                                <StackPanel>
                                                    <TextBlock FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="{loc:T '可用包'}" />
                                                    <Grid Margin="0,6,0,0">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="MO-INI.zip"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <c:OutlineButton HorizontalAlignment="Right"
                                                                         Content="{loc:T '安装'}"
                                                                         Padding="6,2"
                                                                         FontSize="9.5" />
                                                    </Grid>
                                                    <Grid Margin="0,5,0,0">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="MO-Map.zip"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <c:OutlineButton HorizontalAlignment="Right"
                                                                         Content="{loc:T '安装'}"
                                                                         Padding="6,2"
                                                                         FontSize="9.5" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{DynamicResource Radius.Small}"
                                                    Padding="8">
                                                <StackPanel>
                                                    <TextBlock FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="{loc:T '当前实例已安装'}" />
                                                    <Grid Margin="0,6,0,0">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Text="Voice.zip"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <c:OutlineButton HorizontalAlignment="Right"
                                                                         Content="{loc:T '卸载'}"
                                                                         Tone="Danger"
                                                                         Padding="6,2"
                                                                         FontSize="9.5" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 标注 1：页头 -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 页头：导入包 / 打开包目录 / 刷新'}" />

                                        <!-- 标注 2：当前实例条 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 安装 / 卸载作用于「当前实例」；「管理实例」跳到游戏实例页'}" />

                                        <!-- 标注 3：四个分类 -->
                                        <svg:SvgIcon Grid.Row="3" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 四个分类：INI / 地图 / 任务 / 插件，切换分类切换在看的包'}" />

                                        <!-- 标注 4：两个列表 -->
                                        <svg:SvgIcon Grid.Row="4" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 左边「可用包」（安装 / 移除），右边「当前实例已安装」（卸载）；已装过的包会带绿色「已安装」徽标'}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 联机 -->
                    <Border x:Name="SecMultiplayer"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            Padding="14,12"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26"
                                    Height="26"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{DynamicResource Radius.Small}">
                                <svg:SvgIcon Width="14"
                                             Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Icon="lucide/network"
                                             IconBrush="{DynamicResource Accent.Base}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '联机'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 三种组网方案：EasyTier（三层组网，免装驱动，推荐）、n2n（二层组网，需要先装 TAP 虚拟网卡驱动）、樱花 Frp（端口映射直连）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 用法：先在「设置 → 联机设置」填好联机昵称（与 CnCNet 客户端的玩家名共用），再进「联机」页选方案、填房间名与密钥、点「进入」，然后把房间信息发给队友。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 联机页里还有：在线大厅（公开房间、聊天、邀请入房）、房间聊天与房主管理、收藏队友、文件传输、游戏内 HUD 浮窗（可以单独调透明度）、网络工具箱（PING、上下行测速、NAT 类型、防火墙开关、网卡跃点数、安装 TAP 驱动、自建节点）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 组网组件不随包分发：缺哪个会在连接前提示，并可以在「下载」页下载。'}" />

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '选哪种方案'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· EasyTier（三层组网）：免装驱动，最常见也最省心，作为默认推荐；默认走公共节点，节点不通时也能填自建节点。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· n2n（二层组网）：需要先装 TAP 虚拟网卡驱动；对某些老游戏的局域网发现更友好。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 樱花 Frp（端口映射直连）：适合自己有公网或有 Frp 账号的场景。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 同一个房间的每个人必须选同一种方案、填同一个房间名与密钥，否则互相发现不了。'}" />

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '开一局要做的几步'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第一步：到「设置 → 联机设置」填好联机昵称（与 CnCNet 客户端的玩家名共用同一个值）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第二步：进「联机」页 →「组网」分类，选一种方案。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第三步：填房间名与密钥（密钥用你自定的口令，两边一致即可）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第四步：点「进入」，等连接状态变成已连接。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第五步：把房间信息（或分享口令）发给队友，他们照做就能进同一局。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第六步：游戏内走红警 / 心灵终结的「局域网」大厅 —— 房主建房，其他人就能看到并加入。'}" />

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '页里还有什么'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 联机大厅：公开房间列表、聊天、邀请入房、收藏队友。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 房间聊天与房主管理：房间成员都能聊天，房主可以踢人，也能把踢错的人拉回。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 文件传输：给队友传地图、INI、补丁等文件。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 游戏内 HUD 浮窗：可以单独调透明度，只显示本房间的对端。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 网络工具箱：PING、上下行测速、NAT 类型、防火墙开关、网卡跃点数、安装 TAP 驱动、自建节点。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「对端」分类能看到同一房间里其他人的虚拟 IP 与在线状态。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「引擎日志」分类里能看组网引擎自己输出的日志，是连不上时最有用的排查材料。'}" />

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '连不上怎么查'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 先看「引擎日志」，引擎的报错最直接。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 确认两边方案、房间名、密钥完全一致。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 缺组网组件时到「下载」页补，页顶「运行环境」可以一键补全（缺组件时的提示原文是「缺少组网组件，请到左侧「下载」页下载」）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 用 n2n 的话，记得先装好 TAP 驱动。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 还不行就用工具箱测 PING 与 NAT 类型，并检查防火墙是否拦了组网端口；连上了却在游戏里看不到房间，多半是方案不一致、房间名 / 密钥不一致，或防火墙拦了。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 联机页左边有「返回」「组网」「大厅」「对端」「引擎日志」五项：点后四个就在页内切换子视图，「返回」回到主页面导航。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「组网」里选 EasyTier / n2n 时要填三样：节点服务器（旁边有「节点测速」「自定义节点」）、房间名称（小组名，最多 6 个字符，可点「随机生成」）、加密密钥（可选，留空就不加密）。&#10;· 下面还能选「虚拟 IP 模式」：自动（由节点分配）或手动（建议从 .66 起，同一房间里两台机器不能填一样的地址）。&#10;· 选 n2n 的话还要先点「安装 TAP 驱动」把虚拟网卡装好，否则连不上。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「樱花 Frp 参数」是选樱花方案时用的：填访问密钥、选节点、新建一条 TCP 隧道（本地端口要用 1233），准备好 frpc 再启动隧道，然后把「连接地址」里的 IP 发给队友，队友在 MO「局域网大厅」底部的地址框里粘上回车即可加入。&#10;· 这是实验特性：进游戏后的数据要经隧道中继转发，所以双方都得用带中继的客户端；TCP 承载 UDP 在网络抖动时可能卡顿，求稳改用 EasyTier / n2n。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「连接」卡显示连接状态、虚拟 IP，以及 NAT / PeerID / 公网 IP；还有一个「公开我的房间到大厅」开关，打开后别人能在「大厅」的公开房间列表里一键加入。&#10;· 卡右下角的大按钮：没连上时是「连接」，连接中是「取消连接」，已连接时是「断开」。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「分享给队友」卡：连上后点「复制分享文本」把一段说明发给队友，队友在组网页点「粘贴分享文本一键加入」就能自动填好并连接；也能点「分享文本窗口」自己看这段文本。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「大厅」需要先在「设置 → 联机设置」填好昵称，没填昵称进不去。进去后有「在线玩家」「公开房间」「收藏队友」三块：可以收藏玩家、邀请别人入房、一键加入公开房间、开大厅聊天。&#10;· 大厅是公共信标广场，聊天内容对第三方可见，不要发敏感信息。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「对端」连上后每 3 秒自动刷新，能看到同房间玩家的虚拟 IP、延迟与状态（被移出房间的人不会出现在这里）。&#10;· 房主在这里还能「踢出选中」捣乱的人、「拉回被踢玩家」，以及打开「房间聊天」；踢人与拉回仅房主可用（手动点「连接」建房的一方就是房主）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 「引擎日志」记录组网引擎（EasyTier / n2n）与樱花 Frp 的运行输出，最多保留 300 行，能「导出日志」「清空」，是连不上时最直接的排查材料。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 组网页底部的「网络工具箱」是一排工具：「连通性检测」（PING / TCP·UDP 测速 / NAT 检测）、「防火墙控制」、「网卡优先级」、「文件传输」、「更多设置」（自定义节点 / 进程守护 / 开机自启）、「游戏 HUD」、「大厅延迟代码」、「广播转发服务」。&#10;· 涉及系统改动的（装驱动、开关防火墙、改网卡跃点等）都会先说明再执行，需要时弹系统提权；联机结束后建议把防火墙恢复回去。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 窗口标题条 -->
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Width="420"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="8,5">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/HMOL;component/Assets/AppIcon.ico" Width="14" Height="14" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="Hello Mental Omega Launcher" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                    <Border Width="6" Height="6" Margin="4,0,0,0" CornerRadius="3" Background="{DynamicResource Border.Default}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 联机页自己的分类栏（跨第 1~2 行） -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Width="118"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="4">
                                            <StackPanel>
                                                <c:NavItem GroupName="MockMpNav" Icon="lucide/arrow-left" Text="{loc:T '返回'}" />
                                                <c:NavItem GroupName="MockMpNav" IsChecked="True" Icon="lucide/network" Text="{loc:T '组网'}" />
                                                <c:NavItem GroupName="MockMpNav" Icon="lucide/message-circle" Text="{loc:T '大厅'}" />
                                                <c:NavItem GroupName="MockMpNav" Icon="lucide/ethernet-port" Text="{loc:T '对端'}" />
                                                <c:NavItem GroupName="MockMpNav" Icon="lucide/scroll-text" Text="{loc:T '引擎日志'}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 组网内容 -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Width="292"
                                                    HorizontalAlignment="Left"
                                                    Margin="128,6,0,0">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{loc:T '联机'}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Text="{loc:T '组网方案'}" />
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <c:OutlineButton Content="EasyTier" Tone="Solid" Padding="8,3" FontSize="10.5" />
                                                <c:OutlineButton Content="n2n" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                                <c:OutlineButton Content="樱花 Frp" Padding="8,3" FontSize="10.5" Margin="5,0,0,0" />
                                            </StackPanel>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Height="24"
                                                        Background="{DynamicResource Surface.Sunken}"
                                                        CornerRadius="{DynamicResource Radius.Button}"
                                                        Padding="7,0">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="my-room" />
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Height="24"
                                                        Background="{DynamicResource Surface.Sunken}"
                                                        CornerRadius="{DynamicResource Radius.Button}"
                                                        Padding="7,0">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="******" />
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{loc:T '连接状态：未连接'}" />
                                                <c:OutlineButton HorizontalAlignment="Right"
                                                                 Content="{loc:T '连接'}"
                                                                 Tone="Solid"
                                                                 Padding="9,3"
                                                                 FontSize="10.5" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- 网络工具箱 -->
                                        <WrapPanel Grid.Row="2"
                                                   Grid.Column="0"
                                                   Width="292"
                                                   HorizontalAlignment="Left"
                                                   Margin="128,8,0,0">
                                            <c:OutlineButton Content="{loc:T '连通性检测'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '防火墙控制'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '网卡优先级'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '文件传输'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '更多设置'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                            <c:OutlineButton Content="{loc:T '游戏 HUD'}" Padding="7,3" FontSize="10" Margin="0,0,4,4" />
                                        </WrapPanel>

                                        <!-- 标注 1：分类栏 + 组网 -->
                                        <svg:SvgIcon Grid.Row="1" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 左边是联机自己的分类（组网 / 大厅 / 对端 / 引擎日志）；「组网」里选方案、填房间名与密钥，点「连接」'}" />

                                        <!-- 标注 2：网络工具箱 -->
                                        <svg:SvgIcon Grid.Row="2" Grid.Column="1" Icon="lucide/arrow-left" Width="14" Height="14" Margin="6,0,4,0" VerticalAlignment="Center" IconBrush="{DynamicResource Accent.Base}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:T '· 组网页下方的「网络工具箱」：连通性检测、防火墙、网卡优先级、文件传输、更多设置、游戏 HUD 等'}" />
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '照着做就能连上'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 联机是两个人以上一起做的事：你和队友各做一遍完全一样的步骤，只是其中一方当房主。动手前先和队友约好谁当房主、用哪种方案、房间名和密钥是什么，后面就不用反复改。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 1 步：把游戏和启动器都准备好——启动器里要先有一个实例（没有就先建一个），队友那边也要用同样的游戏版本，版本不一致会进不去或中途掉线。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 2 步：打开「设置 → 联机设置」，在联机昵称里填一个名字，填完点「保存昵称」。这一步不做，房间列表里就会显示不出名字。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 3 步：回到左边点「联机」进联机页；页面左边有三个分类：「组网」「大厅」「对端」（还有一个「引擎日志」）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 4 步：在「组网」分类里选一种方案——建议选 EasyTier（免装驱动，选完直接能用）；如果选 n2n，先点「安装 TAP 驱动」把驱动装好再继续。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 5 步：在「组网」里填好房间名和密钥——房间名随便取一个（最多 6 个字符），密钥就是一个口令，两边填的一模一样就行。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 6 步：点「进入」开始连接；等「连接状态」变成「已连接」（这一步有时要等十几秒）。如果一直连不上，就去看前面「连不上怎么查」那一节。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 7 步：连接成功后，把房间名和密钥发给队友（用聊天软件发原文就行）；队友从他的启动器照第 3~6 步做一遍，也会显示「已连接」。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 8 步：两边都连上以后，切到「对端」分类看一眼——能看到对方的「虚拟 IP」和在线状态，就说明组网通了。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 9 步：两边各自回「主页」点「启动游戏」把游戏打开（如果这个实例配了多个版本，先选要玩的那个版本）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 10 步：进游戏后走「局域网」：当房主的人先建房间（在局域网大厅里点创建 / 新建游戏），其他人等几秒就能在局域网大厅里看到这个房间，点进去加入。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 第 11 步：都进房间后就可以开局了；如果谁看不到房间，就比较两边「对端」里显示的虚拟 IP 是不是在同一网段，再看「引擎日志」里有没有报错。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 补充：房间里还能做这些——用「文件传输」给队友发地图 / INI / 补丁；房主遇到捣乱的可以踢人（「踢出选中」），踢错了也能拉回来（「拉回被踢玩家」）。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 补充：游戏内浮窗（「游戏 HUD」）能在游戏里看到谁在线、延迟多少，透明度可以在「设置 → HUD 透明度」里单独调。'}" />

                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="{loc:T '界面示意'}" />
                                <Border Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Card}"
                                        Padding="12"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 拟真界面底：仿「组网」分类 -->
                                        <Border Grid.Row="0"
                                                Grid.RowSpan="5"
                                                Grid.Column="0"
                                                Width="340"
                                                Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10" />

                                        <!-- 第一步：方案按钮 -->
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="10,10,10,0"
                                                    Orientation="Horizontal">
                                            <c:OutlineButton Content="EasyTier" Tone="Solid" Padding="10,4" FontSize="11.5" />
                                            <c:OutlineButton Content="n2n" Tone="Outline" Padding="10,4" FontSize="11.5" Margin="6,0,0,0" />
                                            <c:OutlineButton Content="樱花 Frp" Tone="Outline" Padding="10,4" FontSize="11.5" Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- 第二步：房间名 -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="10,8,10,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       Text="{loc:T '房间名'}" />
                                            <Border Height="28"
                                                    Margin="0,4,0,0"
                                                    Background="{DynamicResource Surface.Card}"
                                                    BorderBrush="{DynamicResource Border.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Button}"
                                                    Padding="8,0">
                                                <TextBlock HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="my-room" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 第三步：密钥 -->
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="10,8,10,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       Text="{loc:T '密钥'}" />
                                            <Border Height="28"
                                                    Margin="0,4,0,0"
                                                    Background="{DynamicResource Surface.Card}"
                                                    BorderBrush="{DynamicResource Border.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Button}"
                                                    Padding="8,0">
                                                <TextBlock HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="123456" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 第四步：进入 -->
                                        <c:OutlineButton Grid.Row="3"
                                                         Grid.Column="0"
                                                         Margin="10,10,10,0"
                                                         HorizontalAlignment="Left"
                                                         Content="{loc:T '进入'}"
                                                         Tone="Solid"
                                                         Padding="10,4"
                                                         FontSize="11.5" />

                                        <!-- 第五步：分享给队友 -->
                                        <StackPanel Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="10,8,10,10">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       Text="{loc:T '分享给队友'}" />
                                            <Border Height="28"
                                                    Margin="0,4,0,0"
                                                    Background="{DynamicResource Surface.Card}"
                                                    BorderBrush="{DynamicResource Border.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Button}"
                                                    Padding="8,0">
                                                <TextBlock HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
