                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 配置向导只在第一次运行时出现，带你做「选目录 → 检查环境 → 创建实例」。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 每一步都能跳过或后退，中途退出也不会弄坏已有配置。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T '· 之后想重跑，可以在「设置 → 游戏路径 → 重新运行配置向导」里再打开它。'}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
