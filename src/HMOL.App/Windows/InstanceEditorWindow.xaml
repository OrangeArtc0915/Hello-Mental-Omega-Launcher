<Window xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Windows.InstanceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <StackPanel Margin="16,12,16,16">

            <!-- 实例名称 -->
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{loc:T '实例名称'}" />
            <Border Height="38"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}">
                <TextBox x:Name="TxtName"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         TextChanged="OnNameChanged" />
            </Border>

            <!-- 游戏目录 -->
            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{loc:T '游戏目录'}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="38"
                        Padding="10,0"
                        Background="{DynamicResource Surface.Sunken}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Button}">
                    <TextBox x:Name="TxtGameDir"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource Text.Primary}"
                             Foreground="{DynamicResource Text.Primary}"
                             TextChanged="OnGameDirChanged" />
                </Border>

                <c:OutlineButton Grid.Column="2"
                                 Height="38"
                                 Padding="14,0"
                                 Content="{loc:T '浏览…'}"
                                 Click="OnBrowseClick" />
            </Grid>

            <!-- 目录校验结果 -->
            <TextBlock x:Name="LabDirState"
                       Margin="0,8,0,0"
                       FontSize="11.5"
                       TextWrapping="Wrap" />

            <!-- 游戏类型 -->
            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{loc:T '游戏类型'}" />
            <WrapPanel x:Name="PanKinds" Margin="0,6,0,0">
                <c:OutlineButton Tag="MentalOmega"
                                 Margin="0,0,6,6"
                                 Padding="12,5"
                                 Content="{loc:T '心灵终结'}"
                                 FontSize="12.5"
                                 Click="OnKindClick" />
                <c:OutlineButton Tag="OriginalRa2"
                                 Margin="0,0,6,6"
                                 Padding="12,5"
                                 Content="{loc:T '原版（红警2）'}"
                                 FontSize="12.5"
                                 Click="OnKindClick" />
                <c:OutlineButton Tag="YurisRevenge"
                                 Margin="0,0,6,6"
                                 Padding="12,5"
                                 Content="{loc:T '尤里的复仇'}"
                                 FontSize="12.5"
                                 Click="OnKindClick" />
                <c:OutlineButton Tag="Other"
                                 Padding="12,5"
                                 Content="{loc:T '其它红警 Mod'}"
                                 FontSize="12.5"
                                 Click="OnKindClick" />
            </WrapPanel>

            <!-- 游戏主程序（可选）：默认只显示这一个输入框；点「多版本…」才切到下面的多版本列表 -->
            <StackPanel x:Name="PanSingleExe" Margin="0,10,0,0">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{loc:T '游戏主程序（可选）'}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="38"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtExe"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnExecutableChanged" />
                    </Border>

                    <c:OutlineButton Grid.Column="2"
                                     Height="38"
                                     Padding="14,0"
                                     Content="{loc:T '浏览…'}"
                                     Click="OnBrowseExeClick" />
                </Grid>
                <c:OutlineButton Margin="0,8,0,0"
                                 HorizontalAlignment="Left"
                                 Padding="12,5"
                                 FontSize="12.5"
                                 Content="{loc:T '多版本…'}"
                                 Click="OnEnableVersionsClick" />
            </StackPanel>

            <!-- 游戏版本（可选）：点「多版本…」后显示，同一目录里的多个 exe 各加一行，启动时按名字选 -->
            <StackPanel x:Name="PanVersionSection" Visibility="Collapsed">
                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{loc:T '游戏版本（可选）'}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Text="{loc:T '留空则按游戏类型自动找主程序。同一个文件夹里有两个版本时，点「添加版本」一次选中 2 个 exe，再分别起名；启动游戏时会先让你选版本。'}" />
                <StackPanel x:Name="PanVersions" Margin="0,8,0,0" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <c:OutlineButton Padding="12,5"
                                     FontSize="12.5"
                                     Content="{loc:T '添加版本…'}"
                                     Click="OnAddVersionsClick" />
                    <c:OutlineButton x:Name="BtnAddDetected"
                                     Margin="8,0,0,0"
                                     Padding="12,5"
                                     FontSize="12.5"
                                     Content="{loc:T '加入目录里的主程序'}"
                                     Click="OnAddDetectedClick"
                                     Visibility="Collapsed" />
                    <c:OutlineButton Margin="8,0,0,0"
                                     Padding="12,5"
                                     FontSize="12.5"
                                     Content="{loc:T '回到单版本'}"
                                     Click="OnBackToSingleClick" />
                </StackPanel>
            </StackPanel>

            <!-- 同文件夹多实例：同一目录里的另一个版本各建一个实例（默认关闭） -->
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{loc:T '同文件夹多实例'}" />
                <c:OutlineButton x:Name="BtnSharedDir"
                                 Margin="10,0,0,0"
                                 Padding="12,5"
                                 FontSize="12.5"
                                 Click="OnToggleSharedDirClick" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="{loc:T '打开后允许同一个游戏目录再建一个实例（一般只在两套不同的包组合要共用同一目录时才需要）；同一个文件夹里的两个版本请用上面的「添加版本」，更直接。共用的实例会共用同一目录与备份，但各自的「已安装包」记录相互独立。'}" />

            <!-- 备注 -->
            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{loc:T '备注'}" />
            <Border Height="38"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}">
                <TextBox x:Name="TxtNote"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}" />
            </Border>

            <TextBlock Margin="0,14,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="{loc:T '心灵终结目录需含 Mental_Omega 子目录或特征主程序；原版 / 尤复需有对应主程序（ra2.exe / ra2md.exe）；其它红警 Mod 请手动指定主程序，指定后对目录不再作要求。'}" />

            <StackPanel Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <c:OutlineButton Width="88"
                                 Height="34"
                                 Content="{loc:T '取消'}"
                                 Click="OnCancelClick" />
                <c:OutlineButton x:Name="BtnSave"
                                 Width="88"
                                 Height="34"
                                 Margin="8,0,0,0"
                                 Content="{loc:T '保存'}"
                                 IsEnabled="False"
                                 Tone="Solid"
                                 Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </c:SurfaceCard>
</Window>
