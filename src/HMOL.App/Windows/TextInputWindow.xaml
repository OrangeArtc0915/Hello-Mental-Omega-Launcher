<Window xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Windows.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock x:Name="LabMessage"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Primary}"
                       TextWrapping="Wrap" />

            <Border Height="36"
                    Margin="0,10,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Button}">
                <TextBox x:Name="TxtValue"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         TextChanged="OnValueChanged" />
            </Border>

            <TextBlock x:Name="LabError"
                       Margin="0,8,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Status.Danger}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <TextBlock x:Name="LabHint"
                       Margin="0,8,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <c:OutlineButton Width="88"
                                 Height="32"
                                 Content="{loc:T '取消'}"
                                 Click="OnCancelClick" />
                <c:OutlineButton x:Name="BtnOk"
                                 Width="88"
                                 Height="32"
                                 Margin="8,0,0,0"
                                 Content="{loc:T '确定'}"
                                 Tone="Solid"
                                 Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </c:SurfaceCard>
</Window>
