<Window x:Class="HMOL.App.Windows.ExtensionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        xmlns:svg="clr-namespace:HMOL.App.Controls.Svg"
        Width="640"
        Height="700"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard Padding="0" UseShadow="False">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 清单保存位置：讲清宿主只会写这一个文件 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <svg:SvgIcon Width="13"
                             Height="13"
                             VerticalAlignment="Center"
                             Icon="lucide/file-input"
                             IconBrush="{DynamicResource Text.Tertiary}" />
                <TextBlock x:Name="LabFilePath"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <!-- 名称 -->
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="名称（必填）" />
                    <Border Height="36"
                            Margin="0,6,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtTitle"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 MaxLength="40"
                                 TextChanged="OnTitleChanged" />
                    </Border>
                    <TextBlock x:Name="LabTitleHint"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="名称是最长 40 字的卡片标题；卡片外观与内置的日历 / 天气 / 常用网站一致。" />

                    <!-- 图标 -->
                    <TextBlock Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="图标" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="36"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Button}">
                            <TextBox x:Name="TxtIcon"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     MaxLength="40"
                                     TextChanged="OnIconChanged" />
                        </Border>

                        <Border Grid.Column="2"
                                Width="36"
                                Height="36"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Button}">
                            <svg:SvgIcon x:Name="IcoPreview"
                                         Width="16"
                                         Height="16"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="lucide/puzzle"
                                         IconBrush="{DynamicResource Accent.Base}" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="LabIconHint"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />

                    <!-- 版本 / 作者 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="版本号" />
                            <Border Height="36"
                                    Margin="0,6,0,0"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Button}">
                                <TextBox x:Name="TxtVersion"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         MaxLength="20" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="作者" />
                            <Border Height="36"
                                    Margin="0,6,0,0"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Button}">
                                <TextBox x:Name="TxtAuthor"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         MaxLength="30" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 说明 -->
                    <TextBlock Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="说明（只显示在设置页的列表里）" />
                    <Border Height="36"
                            Margin="0,6,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtDescription"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 MaxLength="120" />
                    </Border>

                    <!-- 主数值 -->
                    <TextBlock Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="主数值（卡片上的大字，最长 60 字）" />
                    <Border Height="36"
                            Margin="0,6,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtValue"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 MaxLength="60" />
                    </Border>

                    <!-- 文字行 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="文字行（最多 8 行；标签 12 字、内容 200 字）" />
                        <c:OutlineButton x:Name="BtnAddLine"
                                         Grid.Column="1"
                                         Padding="10,4"
                                         FontSize="12"
                                         Content="添加一行"
                                         Click="OnAddLineClick" />
                    </Grid>

                    <StackPanel x:Name="PanLines" Margin="0,8,0,0" />

                    <!-- 数据源 -->
                    <TextBlock Margin="0,16,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="数据源（可选：只读 GET 一个返回 JSON 的网址）" />

                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="网址（必须是 http / https）" />
                    <Border Height="36"
                            Margin="0,6,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtDataUrl"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 MaxLength="500" />
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="取值路径（如 current.temperature_2m）" />
                            <Border Height="36"
                                    Margin="0,6,0,0"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Button}">
                                <TextBox x:Name="TxtDataPath"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         MaxLength="200" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="刷新间隔（秒）" />
                            <Border Height="36"
                                    Margin="0,6,0,0"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Button}">
                                <TextBox x:Name="TxtRefresh"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="刷新间隔同时也是缓存有效期（最少 60 秒）。不填数据源网址就表示这个扩展只用静态内容。" />

                    <!-- 点击打开网址 -->
                    <TextBlock Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="点击打开的网址（可选：填了之后整张卡可点）" />
                    <Border Height="36"
                            Margin="0,6,0,0"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtLink"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 MaxLength="500" />
                    </Border>

                    <!-- 启用状态 -->
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="启用状态" />
                        <c:OutlineButton x:Name="BtnEnabled"
                                         Margin="10,0,0,0"
                                         Click="OnToggleEnabledClick" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="停用后主页上不显示这张卡，清单仍然保留。" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="LabError"
                           FontSize="11.5"
                           Foreground="{DynamicResource Status.Danger}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <StackPanel Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <c:OutlineButton Width="88"
                                     Height="34"
                                     Content="取消"
                                     Click="OnCancelClick" />
                    <c:OutlineButton x:Name="BtnSave"
                                     Width="88"
                                     Height="34"
                                     Margin="8,0,0,0"
                                     Content="保存"
                                     Tone="Solid"
                                     Click="OnSaveClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </c:SurfaceCard>
</Window>
