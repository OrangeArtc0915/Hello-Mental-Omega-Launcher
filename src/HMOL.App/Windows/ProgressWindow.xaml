<Window x:Class="HMOL.App.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Title="正在处理"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <TextBlock x:Name="LabDetail"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="准备中…" />

            <ProgressBar x:Name="Bar"
                         Margin="0,12,0,0"
                         Maximum="1"
                         Minimum="0"
                         Value="0" />

            <StackPanel Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnCancel"
                                 Width="88"
                                 Height="32"
                                 Content="取消"
                                 Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>
    </c:SurfaceCard>
</Window>
