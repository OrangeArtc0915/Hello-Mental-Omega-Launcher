<Window xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Windows.PackagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="660"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard Padding="0" UseShadow="False">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="LabTitle"
                       FontSize="13"
                       Foreground="{DynamicResource Text.Primary}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="LabSummary"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap" />

            <!-- 文件清单：可能上千条，交给 ListBox 虚拟化 -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Item}">
                <Grid>
                    <TextBlock x:Name="LabEmpty"
                               Margin="12"
                               VerticalAlignment="Top"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <ListBox x:Name="ListFiles"
                             Padding="4"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Text.Primary}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Consolas, Microsoft YaHei UI"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Path}"
                                               TextWrapping="Wrap" />
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Accent.Faint}"
                                            CornerRadius="{DynamicResource Radius.Item}">
                                        <TextBlock FontSize="10.5"
                                                   Foreground="{DynamicResource Status.Warn}"
                                                   Text="{Binding Badge}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabHint"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <c:OutlineButton Width="88"
                                     Height="32"
                                     Content="{loc:T '取消'}"
                                     Click="OnCancelClick" />
                    <c:OutlineButton Width="88"
                                     Height="32"
                                     Margin="8,0,0,0"
                                     Content="{loc:T '继续安装'}"
                                     Tone="Solid"
                                     Click="OnOkClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </c:SurfaceCard>
</Window>
