<Window x:Class="HMOL.App.Windows.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        xmlns:svg="clr-namespace:HMOL.App.Controls.Svg"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <StackPanel Margin="16,12,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 图标列在不用时收成 0 宽，正文自动贴左 -->
                <svg:SvgIcon x:Name="IconDialog"
                             Grid.Column="0"
                             Width="18"
                             Height="18"
                             Margin="0,1,10,0"
                             VerticalAlignment="Top"
                             IconBrush="{DynamicResource Accent.Base}"
                             Visibility="Collapsed" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LabMessage"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="LabDetail"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="PanButtons"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal" />
        </StackPanel>
    </c:SurfaceCard>
</Window>