<Window x:Class="HMOL.App.Windows.ConfigWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="680"
        Height="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        首次运行配置向导。四步内容同处一格、靠 Visibility 切换，不用 Frame / 页面导航。
        「上一步 / 下一步」的可用性全部由 _step / _selectedDir / _installKind 推导，不额外存状态。
        必须在主窗口显示之后才 ShowDialog，否则没有 Owner；判定与排队见 MainWindow.QueueFirstRunWizard。
    -->
    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <Grid Margin="22,14,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 步骤指示：圆点 + 步骤名，由代码生成 -->
            <StackPanel x:Name="PanSteps" Grid.Row="0" Orientation="Horizontal" />

            <!-- 四步内容 -->
            <Grid Grid.Row="1" Margin="0,18,0,0">

                <!-- 第 1 步 · 欢迎 -->
                <StackPanel x:Name="StepWelcome">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="欢迎使用 Hello Mental Omega Launcher" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="这个向导会带你做完第一次运行需要做对的事，做完之后就能直接启动游戏。" />

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="1. 指定游戏目录" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="2. 检查运行环境（主程序与组网组件）" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="3. 创建一个游戏实例" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="向导只负责「问」和「记」：不会安装任何东西，也不会改动你的游戏文件。每一步都可以跳过或后退。" />
                </StackPanel>

                <!-- 第 2 步 · 选择游戏目录 -->
                <StackPanel x:Name="StepDirectory">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="选择游戏目录" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="指向《心灵终结》或红警的安装根目录（通常里面有 Mental_Omega 子目录）。" />

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="游戏目录" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="36"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}">
                            <TextBox x:Name="TxtGameDir"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     TextChanged="OnDirectoryChanged" />
                        </Border>
                        <c:OutlineButton Grid.Column="1"
                                         Height="36"
                                         Margin="8,0,0,0"
                                         Content="浏览…"
                                         Click="OnBrowseDirectoryClick" />
                    </Grid>

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="游戏类型" />
                    <WrapPanel x:Name="PanKinds">
                        <c:OutlineButton Tag="MentalOmega"
                                         Content="心灵终结"
                                         Tone="Solid"
                                         Click="OnKindClick" />
                        <c:OutlineButton Tag="OriginalRa2"
                                         Margin="8,0,0,0"
                                         Content="原版（红警 2）"
                                         Click="OnKindClick" />
                        <c:OutlineButton Tag="YurisRevenge"
                                         Margin="8,0,0,0"
                                         Content="尤里的复仇"
                                         Click="OnKindClick" />
                        <c:OutlineButton Tag="Other"
                                         Margin="8,0,0,0"
                                         Content="其它红警 Mod"
                                         Click="OnKindClick" />
                    </WrapPanel>

                    <StackPanel x:Name="PanExecutable"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Text="游戏主程序（「其它红警 Mod」必须指定）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Height="36"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Button}">
                                <TextBox x:Name="TxtExecutable"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         TextChanged="OnDirectoryChanged" />
                            </Border>
                            <c:OutlineButton Grid.Column="1"
                                             Height="36"
                                             Margin="8,0,0,0"
                                             Content="浏览…"
                                             Click="OnBrowseExecutableClick" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="LabDirectoryState"
                               Margin="0,16,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 3 步 · 检查运行环境 -->
                <StackPanel x:Name="StepEnvironment">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="检查运行环境" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="下面两项只是提醒：缺什么都可以先继续，之后再来补。" />

                    <TextBlock Margin="0,18,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="游戏主程序" />
                    <TextBlock x:Name="LabExecutableState"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,18,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="组网组件（联机用）" />
                    <TextBlock x:Name="LabRuntimeState"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 4 步 · 创建 -->
                <StackPanel x:Name="StepCreate">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="创建游戏实例" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="确认一下要创建什么。这些之后都能在「游戏实例」页里修改。" />

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="实例名称" />
                    <Border Height="36"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}">
                        <TextBox x:Name="TxtName"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnNameChanged" />
                    </Border>

                    <TextBlock Margin="0,14,0,6"
                               FontSize="12"
                               Text="备注（可选）" />
                    <Border Height="36"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}">
                        <TextBox x:Name="TxtNote"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}" />
                    </Border>

                    <TextBlock x:Name="LabSummary"
                               Margin="0,16,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 提示条：失败原因 / 需要用户注意的一句话 -->
            <TextBlock x:Name="LabNotice"
                       Grid.Row="2"
                       Margin="0,12,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- 底部：左侧固定「跳过向导」，右侧上一步 / 下一步 -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <c:OutlineButton x:Name="BtnSkip"
                                 Height="34"
                                 HorizontalAlignment="Left"
                                 Content="跳过向导"
                                 Click="OnSkipClick" />
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <c:OutlineButton x:Name="BtnPrev"
                                     Height="34"
                                     Width="88"
                                     Content="上一步"
                                     Click="OnPrevClick" />
                    <c:OutlineButton x:Name="BtnNext"
                                     Width="88"
                                     Height="34"
                                     Margin="8,0,0,0"
                                     Content="下一步"
                                     Tone="Solid"
                                     Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </c:SurfaceCard>
</Window>
