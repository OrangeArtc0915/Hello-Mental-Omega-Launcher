<Window xmlns:loc="clr-namespace:HMOL.App.Localization" x:Class="HMOL.App.Windows.ConfigWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HMOL.App.Controls"
        Width="680"
        Height="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource AppFont}"
        Icon="pack://application:,,,/HMOL;component/Assets/AppIcon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        首次运行配置向导。四步内容同处一格、靠 Visibility 切换，不用 Frame / 页面导航。
        「上一步 / 下一步」的可用性全部由 _step / _selectedDir / _installKind 推导，不额外存状态。
        必须在主窗口显示之后才 ShowDialog，否则没有 Owner；判定与排队见 MainWindow.QueueFirstRunWizard。
    -->
    <c:SurfaceCard x:Name="Card" Padding="0" UseShadow="False">
        <Grid Margin="22,14,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 步骤指示：圆点 + 步骤名，由代码生成 -->
            <StackPanel x:Name="PanSteps" Grid.Row="0" Orientation="Horizontal" />

            <!-- 五步内容。内容区可滚动：第 5 步较长，也顺便兼容大字号 / 小屏 -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>

                <!-- 第 1 步 · 欢迎 -->
                <StackPanel x:Name="StepWelcome">
                    <!--
                        语言选择放在最顶：新用户进来说的第一件事就是「看不看得懂」。
                        这里的提示刻意写死中英双语、不走 {loc:T}——此刻界面可能正显示着用户看不懂的语言，
                        查表翻译在这恰恰帮不上忙。
                    -->
                    <Border Margin="0,0,0,16"
                            Padding="12,10"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}">
                        <StackPanel>
                            <TextBlock FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="界面语言 / Interface language" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="请选择界面语言，切换后立即生效。 / Choose your interface language — it applies right away." />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextWrapping="Wrap"
                                       Text="（之后随时可以在「设置 → 语言」里改） / (You can change this later in Settings → Language)" />
                            <ComboBox x:Name="CmbWizardLanguage"
                                      Margin="0,8,0,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnWizardLanguageChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{loc:T '欢迎使用 Hello Mental Omega Launcher'}" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '这个向导会带你做完第一次运行需要做对的事，做完之后就能直接启动游戏。向导只负责「问」和「记」：不会安装任何东西，也不会改动你的游戏文件。'}" />

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="{loc:T 'HMOL 主要帮你做四件事'}" />
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Text="{loc:T '· 一个启动器管多个游戏实例：原版、装不同 Mod 的版本各存一份，互不干扰'}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Text="{loc:T '· 装包与卸载：INI / 地图 / 任务 / 插件四类资源包，装错了能单独卸掉'}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Text="{loc:T '· 备份与还原：覆盖原文件前自动留备份，随时能退回原版状态'}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Text="{loc:T '· 联机：把几台电脑组进同一个虚拟局域网，和朋友直接开一局'}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="{loc:T '向导会依次带你做'}" />
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:T '1. 指定游戏目录'}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:T '2. 检查运行环境（主程序与组网组件）'}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:T '3. 创建一个游戏实例'}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:T '4. 看两件建议尽早做的事（备份原版、联机怎么用）'}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '每一步都可以跳过或后退，中途退出也不会弄坏已有配置。'}" />

                    <!-- 非官方声明：首次进来就把关系说清楚，别让人误以为是 MO 官方工具 -->
                    <TextBlock Margin="0,10,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '非官方声明：本程序为玩家自制的第三方启动器，与《心灵终结》开发组 Mentalmeisters 无关联，也未获其授权或认证；本程序不提供游戏本体或官方补丁的下载。'}" />
                </StackPanel>

                <!-- 第 2 步 · 选择游戏目录 -->
                <StackPanel x:Name="StepDirectory">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{loc:T '选择游戏目录'}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '指向《心灵终结》或红警的安装根目录（通常里面有 Mental_Omega 子目录）。'}" />

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="{loc:T '游戏目录'}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="36"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Button}">
                            <TextBox x:Name="TxtGameDir"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     TextChanged="OnDirectoryChanged" />
                        </Border>
                        <c:OutlineButton Grid.Column="1"
                                         Height="36"
                                         Margin="8,0,0,0"
                                         Content="{loc:T '浏览…'}"
                                         Click="OnBrowseDirectoryClick" />
                    </Grid>

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="{loc:T '游戏类型'}" />
                    <WrapPanel x:Name="PanKinds">
                        <c:OutlineButton Tag="MentalOmega"
                                         Content="{loc:T '心灵终结'}"
                                         Tone="Solid"
                                         Click="OnKindClick" />
                        <c:OutlineButton Tag="OriginalRa2"
                                         Margin="8,0,0,0"
                                         Content="{loc:T '原版（红警 2）'}"
                                         Click="OnKindClick" />
                        <c:OutlineButton Tag="YurisRevenge"
                                         Margin="8,0,0,0"
                                         Content="{loc:T '尤里的复仇'}"
                                         Click="OnKindClick" />
                        <c:OutlineButton Tag="Other"
                                         Margin="8,0,0,0"
                                         Content="{loc:T '其它红警 Mod'}"
                                         Click="OnKindClick" />
                    </WrapPanel>

                    <StackPanel x:Name="PanExecutable"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Text="{loc:T '游戏主程序（「其它红警 Mod」必须指定）'}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Height="36"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Button}">
                                <TextBox x:Name="TxtExecutable"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         TextChanged="OnDirectoryChanged" />
                            </Border>
                            <c:OutlineButton Grid.Column="1"
                                             Height="36"
                                             Margin="8,0,0,0"
                                             Content="{loc:T '浏览…'}"
                                             Click="OnBrowseExecutableClick" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="LabDirectoryState"
                               Margin="0,16,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 3 步 · 检查运行环境 -->
                <StackPanel x:Name="StepEnvironment">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{loc:T '检查运行环境'}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '下面两项只是提醒：缺什么都可以先继续，之后再来补。'}" />

                    <TextBlock Margin="0,18,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{loc:T '游戏主程序'}" />
                    <TextBlock x:Name="LabExecutableState"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,18,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{loc:T '组网组件（联机用）'}" />
                    <TextBlock x:Name="LabRuntimeState"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 4 步 · 创建 -->
                <StackPanel x:Name="StepCreate">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{loc:T '创建游戏实例'}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '确认一下要创建什么。这些之后都能在「游戏实例」页里修改。'}" />

                    <TextBlock Margin="0,16,0,6"
                               FontSize="12"
                               Text="{loc:T '实例名称'}" />
                    <Border Height="36"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtName"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnNameChanged" />
                    </Border>

                    <TextBlock Margin="0,14,0,6"
                               FontSize="12"
                               Text="{loc:T '备注（可选）'}" />
                    <Border Height="36"
                            Padding="10,0"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <TextBox x:Name="TxtNote"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}" />
                    </Border>

                    <TextBlock x:Name="LabSummary"
                               Margin="0,16,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 5 步 · 接下来建议做的事 -->
                <StackPanel x:Name="StepNext">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="{loc:T '接下来建议做这两件事'}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '现在就能启动游戏了。但下面这两件事先做掉，后面会省很多麻烦。'}" />

                    <!-- ① 备份原版游戏 -->
                    <Border Margin="0,16,0,0"
                            Padding="14,12"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="{loc:T '① 备份原版游戏'}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource Status.Warn}"
                                           Text="{loc:T '强烈建议先做，且要在还没装任何包的时候做'}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="{loc:T '在「游戏实例」页选中实例，点「备份原版游戏」，它会把一份干净的原版存到 backup\MO。'}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="{loc:T '为什么非要它：装包时难免覆盖掉原版文件，只有靠这份备份才能把原文件还原回去——「按包卸载」（只删掉某个包带来的文件、其它包照旧）就是按它来还原的。'}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Status.Warn}"
                                       TextWrapping="Wrap"
                                       Text="{loc:T '没有这份备份，卸载就只剩「全量恢复」一条路：整个游戏目录清空重来，你之前装的其它包会一起没掉。'}" />
                        </StackPanel>
                    </Border>

                    <!-- ② 联机 -->
                    <Border Margin="0,10,0,0"
                            Padding="14,12"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Card}">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{loc:T '② 想和朋友联机'}" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="{loc:T '联机做的事：把你们几台电脑临时组进同一个虚拟局域网，直接开一局——不需要公网 IP，也不用去路由器上做端口映射。'}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="{loc:T '怎么用：先到「设置 → 联机设置」填一个昵称（大厅和房间里靠它认人），再进「联机」页——选组网方案（EasyTier 或 n2n）、填房间名与密钥、点「进入」，然后把房间信息分享给队友。'}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextWrapping="Wrap"
                                       Text="{loc:T '两点提示：EasyTier 免装驱动，n2n 需要先装 TAP 驱动（联机页的「网络工具箱」里能一键装）；联机双方必须选同一种组网方案、同一个房间名。'}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="{loc:T '这两件事随时都能补做，不影响现在开始玩。'}" />
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 提示条：失败原因 / 需要用户注意的一句话 -->
            <TextBlock x:Name="LabNotice"
                       Grid.Row="2"
                       Margin="0,12,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- 底部：左侧固定「跳过向导」，右侧上一步 / 下一步 -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <c:OutlineButton x:Name="BtnSkip"
                                 Height="34"
                                 HorizontalAlignment="Left"
                                 Content="{loc:T '跳过向导'}"
                                 Click="OnSkipClick" />
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <c:OutlineButton x:Name="BtnPrev"
                                     Height="34"
                                     Width="88"
                                     Content="{loc:T '上一步'}"
                                     Click="OnPrevClick" />
                    <c:OutlineButton x:Name="BtnNext"
                                     Width="88"
                                     Height="34"
                                     Margin="8,0,0,0"
                                     Content="{loc:T '下一步'}"
                                     Tone="Solid"
                                     Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </c:SurfaceCard>
</Window>
