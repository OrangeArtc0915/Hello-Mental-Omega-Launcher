<UserControl x:Class="HMOL.App.Controls.SakuraPlanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:HMOL.App.Controls"
             Foreground="{DynamicResource Text.Primary}">

    <StackPanel>
        <!-- 说明 -->
        <TextBlock FontSize="11.5"
                   Foreground="{DynamicResource Text.Tertiary}"
                   TextWrapping="Wrap"
                   Text="端口映射直连（房主端）：把本地 1233 端口（MO 加入游戏时的握手端口）穿透出去，把「口令」发给队友；队友在 MO 客户端「局域网大厅」底部的地址框里粘上（Ctrl+V）回车即可加入。客户端只认纯 IP，所以口令取的是「IP 地址」那一栏。" />
        <TextBlock Margin="0,8,0,0"
                   FontSize="11.5"
                   Foreground="{DynamicResource Text.Tertiary}"
                   TextWrapping="Wrap"
                   Text="实验特性：进游戏后的数据要由客户端中继经这条隧道转发，因此双方都得用带中继的客户端；TCP 承载 UDP 在网络抖动时可能卡顿，求稳请改用 EasyTier / n2n。" />

        <!-- 访问密钥 -->
        <TextBlock Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="访问密钥（樱花FRP 管理面板 → 复制「访问密钥」）" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Height="32"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBox x:Name="TxtKey"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}" />
            </Border>
            <c:OutlineButton x:Name="BtnVerify"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             Content="验证并加载"
                             Tone="Solid"
                             Click="OnVerifyClick" />
            <c:OutlineButton x:Name="BtnPanel"
                             Grid.Column="2"
                             Margin="8,0,0,0"
                             Content="内嵌面板"
                             Click="OnPanelClick" />
        </Grid>
        <TextBlock x:Name="LabAccount"
                   Margin="0,6,0,0"
                   FontSize="11.5"
                   Foreground="{DynamicResource Text.Tertiary}"
                   TextWrapping="Wrap" />

        <!-- 节点 -->
        <TextBlock Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="节点（新建隧道用；离线的节点不会列出来）" />
        <ListBox x:Name="ListNodes"
                 MinHeight="72"
                 MaxHeight="140"
                 Margin="0,6,0,0"
                 Padding="2"
                 Background="{DynamicResource Surface.Sunken}"
                 BorderBrush="{DynamicResource Border.Default}"
                 BorderThickness="1"
                 Foreground="{DynamicResource Text.Primary}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="{Binding Detail}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 隧道 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="隧道名" />
            <Border Grid.Column="1"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBox x:Name="TxtTunnelName"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}" />
            </Border>
            <c:OutlineButton x:Name="BtnCreate"
                             Grid.Column="2"
                             Margin="8,0,0,0"
                             Content="新建 TCP 隧道"
                             Click="OnCreateTunnelClick" />
            <c:OutlineButton x:Name="BtnRefresh"
                             Grid.Column="3"
                             Margin="8,0,0,0"
                             Content="刷新"
                             Click="OnRefreshTunnelsClick" />
        </Grid>

        <ListBox x:Name="ListTunnels"
                 MinHeight="72"
                 MaxHeight="180"
                 Margin="0,8,0,0"
                 Padding="2"
                 Background="{DynamicResource Surface.Sunken}"
                 BorderBrush="{DynamicResource Border.Default}"
                 BorderThickness="1"
                 Foreground="{DynamicResource Text.Primary}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       Text="{Binding Detail}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <c:OutlineButton Grid.Column="1"
                                         Padding="12,4"
                                         VerticalAlignment="Center"
                                         Content="启动"
                                         FontSize="12"
                                         Tag="{Binding}"
                                         Tone="Solid"
                                         Click="OnStartTunnelClick" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- frpc 与连接地址 -->
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnPrepare"
                             Content="准备 frpc"
                             Click="OnPrepareFrpcClick" />
            <c:OutlineButton x:Name="BtnStop"
                             Margin="8,0,0,0"
                             Content="停止隧道"
                             Tone="Danger"
                             Click="OnStopTunnelClick" />
            <TextBlock x:Name="LabFrpc"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="PanRunning"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           Text="连接地址（发给队友）" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="IP 地址" />
                    <TextBlock x:Name="LabIpAddress"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="12.5"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="等待 frpc 输出…"
                               TextTrimming="CharacterEllipsis" />
                    <c:OutlineButton Grid.Column="2"
                                     Padding="10,3"
                                     Content="复制口令"
                                     FontSize="12"
                                     Click="OnCopyIpCommandClick" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="域名" />
                    <TextBlock x:Name="LabDomainAddress"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               FontSize="12.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="等待 frpc 输出…"
                               TextTrimming="CharacterEllipsis" />
                    <c:OutlineButton Grid.Column="2"
                                     Padding="10,3"
                                     Content="复制域名"
                                     FontSize="12"
                                     Click="OnCopyDomainClick" />
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Status.Warn}"
                           TextWrapping="Wrap"
                           Text="提示：进游戏后的数据经客户端中继走这条隧道，双方都必须用带中继的客户端，否则连不上；网络抖动时可能卡顿，要稳请改用 EasyTier / n2n。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
