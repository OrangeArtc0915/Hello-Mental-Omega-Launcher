<UserControl x:Class="HMOL.App.Views.BackgroundLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- 整层不参与命中测试：背景铺在标题栏与侧栏下面，不能挡住按钮 -->
    <Grid x:Name="PanRoot" ClipToBounds="True">
        <!-- 静态图与动图共用 Image：动图靠换 Source 逐帧播放；平铺用 Rectangle + ImageBrush -->
        <Grid x:Name="PanMedia">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TfParallax" />
            </Grid.RenderTransform>

            <!-- 平铺背景：只对静态图片使用 -->
            <Rectangle x:Name="RecBackground" Visibility="Collapsed" />

            <!-- 模糊只给图片与 GIF（效果在代码里挂上去）：视频叠 BlurEffect 需要整帧软件合成，
                 代价过高，旧版对视频也只做暗化（HMOL_qt.py 第 6712 行 _draw_video_bg） -->
            <Image x:Name="ImgBackground"
                   Stretch="UniformToFill"
                   Visibility="Collapsed" />

            <MediaElement x:Name="VidBackground"
                          IsMuted="True"
                          LoadedBehavior="Manual"
                          MediaEnded="OnVideoEnded"
                          MediaFailed="OnVideoFailed"
                          MediaOpened="OnVideoOpened"
                          ScrubbingEnabled="False"
                          Stretch="UniformToFill"
                          UnloadedBehavior="Manual"
                          Visibility="Collapsed" />
        </Grid>

        <!-- 压暗层：背景直接铺在页面标题这类裸文字下面，不压一层标题会糊在图上。
             颜色不写死，取主题的窗口底色（深色主题近黑、浅色主题近白），跟着主题自动变 -->
        <Border x:Name="OverlayDim" Background="Transparent" Opacity="0" />
    </Grid>
</UserControl>
