---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import Icon from "../../components/misc/Icon.astro";
import { getCollection, render } from "astro:content";
import { getResourceCategory } from "../../utils/resource-category";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const entries = (await getCollection("resources")).filter(
		(entry) => !entry.id.startsWith("#TOOLS/"),
	);
	const folders = [...new Set(entries.map((entry) => entry.id.split("/")[0]))];
	return [
		...folders.map((folder) => ({
			params: { slug: folder },
			props: { folder },
		})),
		...entries.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		})),
	];
}

const { entry, folder } = Astro.props;
const isFolderPage = !!folder && !entry;
const category = getResourceCategory(folder || entry.id);

let folderEntries = [];
if (isFolderPage) {
	const all = await getCollection("resources");
	folderEntries = all
		.filter(
			(e) => !e.id.startsWith("#TOOLS/") && e.id.split("/")[0] === folder,
		)
		.sort((a, b) => a.data.order - b.data.order);
}

const { Content } = entry ? await render(entry) : { Content: null };
---

<MainGridLayout title={isFolderPage ? `${category}资源` : entry.data.title}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">

      <a
        href={url("/resources/")}
        class="inline-flex items-center gap-1.5 text-sm text-black/50 dark:text-white/65 hover:text-[var(--primary)] transition mb-8"
      >
        <Icon name="material-symbols:arrow-back" class="text-[1.1rem]" />
        返回资源库
      </a>

      {isFolderPage ? (
        <>
          <header class="mb-10">
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/15 text-black/55 dark:text-white/75">
                {category}
              </span>
              <Icon name="material-symbols:folder-open" class="text-3xl text-[var(--primary)]" />
            </div>
            <h1 class="text-3xl font-bold text-black/90 dark:text-white/90 mb-3">
              {category}资源
            </h1>
            <p class="text-black/50 dark:text-white/65 max-w-2xl">
              该分类下共 {folderEntries.length} 个资源，点击条目查看详情。
            </p>
          </header>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {folderEntries.map((item) => {
              const { data } = item;
              return (
                <a
                  href={url(`/resources/${item.id}/`)}
                  class="card-base group !p-5 border border-black/5 dark:border-white/5 hover:!-translate-y-0.5 transition-all duration-200 relative overflow-hidden"
                >
                  <div class="flex items-center justify-between mb-3">
                    <span class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/15 text-black/55 dark:text-white/75">
                      {category}
                    </span>
                    {data.icon && <Icon name={data.icon} class="text-2xl text-[var(--primary)]" />}
                  </div>
                  {data.image && (
                    <img src={data.image} alt={data.title} class="w-full h-32 object-cover rounded-lg mb-3" />
                  )}
                  <h3 class="font-semibold text-black/85 dark:text-white/85 mb-1 group-hover:text-[var(--primary)] transition-colors">
                    {data.title}
                  </h3>
                  <p class="text-sm text-black/45 dark:text-white/65 mb-3">{data.description}</p>
                  {data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-3">
                      {data.tags.map((tag) => (
                        <span class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-black/40 dark:text-white/60">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <span class="text-xs font-medium text-[var(--primary)] group-hover:underline">
                    查看详情 →
                  </span>
                </a>
              );
            })}
          </div>
        </>
      ) : (
        <>
          <header class="mb-10">
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/15 text-black/55 dark:text-white/75">
                {category}
              </span>
              {entry.data.icon && <Icon name={entry.data.icon} class="text-3xl text-[var(--primary)]" />}
            </div>
            <h1 class="text-3xl font-bold text-black/90 dark:text-white/90 mb-3">{entry.data.title}</h1>
            <p class="text-black/50 dark:text-white/65 max-w-2xl mb-4">{entry.data.description}</p>
            {(entry.data.author ||
              entry.data.gameVersion ||
              entry.data.version ||
              entry.data.mode) && (
              <div class="flex flex-wrap gap-x-5 gap-y-2 mb-4">
                {entry.data.author && (
                  <span class="inline-flex items-center gap-1.5 text-sm text-black/60 dark:text-white/65">
                    <Icon name="material-symbols:person" class="text-[1.05rem] text-[var(--primary)]" />
                    {entry.data.author}
                  </span>
                )}
                {entry.data.gameVersion && (
                  <span class="inline-flex items-center gap-1.5 text-sm text-black/60 dark:text-white/65">
                    <Icon name="material-symbols:videogame-asset" class="text-[1.05rem] text-[var(--primary)]" />
                    游戏版本：{entry.data.gameVersion}
                  </span>
                )}
                {entry.data.version && (
                  <span class="inline-flex items-center gap-1.5 text-sm text-black/60 dark:text-white/65">
                    <Icon name="material-symbols:tag" class="text-[1.05rem] text-[var(--primary)]" />
                    版本：{entry.data.version}
                  </span>
                )}
                {entry.data.mode && (
                  <span class="inline-flex items-center gap-1.5 text-sm text-black/60 dark:text-white/65">
                    <Icon
                      name={
                        entry.data.mode === "multi" || entry.data.mode === "both"
                          ? "material-symbols:group"
                          : "material-symbols:person-single"
                      }
                      class="text-[1.05rem] text-[var(--primary)]"
                    />
                    {entry.data.mode === "multi"
                      ? "联机"
                      : entry.data.mode === "both"
                        ? "单人+联机"
                        : "单人"}
                  </span>
                )}
              </div>
            )}
            {entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {entry.data.tags.map((tag) => (
                  <span class="inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-black/40 dark:text-white/60">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
            {entry.data.image && (
              <img src={entry.data.image} alt={entry.data.title} class="mt-6 w-full max-w-xl rounded-lg border border-black/5 dark:border-white/5" />
            )}
            {entry.data.link && (
              <a
                href={entry.data.link}
                target={entry.data.link.startsWith("http") ? "_blank" : null}
                class="inline-flex items-center gap-2 rounded-lg px-6 h-12 font-bold text-white bg-[var(--primary)] hover:opacity-90 transition mt-6"
              >
                {entry.data.link.startsWith("http") ? "前往获取" : "查看资源"}
                <Icon name="material-symbols:arrow-forward" class="text-[1.1rem]" />
              </a>
            )}
            {entry.data.links.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {entry.data.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    class="inline-flex items-center gap-1.5 rounded-lg px-4 h-10 text-sm font-medium border border-black/10 dark:border-white/15 text-black/70 dark:text-white/75 hover:border-[var(--primary)] hover:text-[var(--primary)] transition"
                  >
                    <Icon name="material-symbols:link" class="text-[1rem]" />
                    {link.name}
                  </a>
                ))}
              </div>
            )}
          </header>

          <div class="border-t border-black/5 dark:border-white/5 pt-8">
            <div class="prose dark:prose-invert prose-base !max-w-none custom-md">
              <Content />
            </div>
          </div>
        </>
      )}

    </div>
  </div>
</MainGridLayout>
