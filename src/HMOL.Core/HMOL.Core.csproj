<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HMOL.Core</RootNamespace>
    <AssemblyName>HMOL.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!-- 密钥落盘加密用 DPAPI（Security\SecretProtector.cs）：net8.0-windows 类库不在
         WindowsDesktop 框架引用里，得显式引这个包。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 壁纸包解包工具 RePKG.exe（第三方，运行时释放到 Data\Cache）。
         用二进制内嵌资源而不是 Base64：省约 1/3 体积，也不用再维护生成脚本。 -->
    <EmbeddedResource Include="Resources\RePKG.exe" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌语言包：Loc 从程序集资源 HMOL.Core.Languages.<code>.json 读，
         Data\lang\<code>.json 可整份覆盖同名条目；新增语种把 json 丢进来即可。 -->
    <EmbeddedResource Include="Languages\*.json" />
  </ItemGroup>

</Project>
